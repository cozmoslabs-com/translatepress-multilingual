msgid "Not TranslatePress onboarding page."
msgstr "No és la pàgina de benvinguda de TranslatePress."

msgid "Step %s does not exist"
msgstr "El pas %s no existeix"

msgid "Welcome"
msgstr "Benvinguda"

msgid "Add Languages"
msgstr "Afegeix idiomes"

