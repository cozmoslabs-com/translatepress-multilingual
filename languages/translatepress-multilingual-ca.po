msgstr ""
"L'idioma per defecte no es pot eliminar. Estableix primer un altre idioma "
"per defecte."

#, tp-ai, tp-ctx-07893e52, tp-glo-67834fcb, tp-glo-9fa92a70
msgid "Slug is empty after sanitization. Use only URL-safe characters."
msgstr ""
"El slug és buit després del sanejament. Utilitza només caràcters segurs per "
"a URL."

#, tp-ai, tp-glo-ee8b4f9f
msgid ""
"Language \"%s\" is not currently configured. Add it first with "
"translatepress/add-language."
msgstr ""
"L'idioma \"%s\" no està configurat actualment. Afegeix-lo primer amb "
"translatepress/add-language."

#, tp-ai
msgid "The default language is always published and cannot be unpublished."
msgstr "L'idioma per defecte sempre està publicat i no es pot despublicar."

#, tp-ai, tp-ctx-07893e52, tp-glo-67834fcb
msgid "Slug \"%1$s\" is already in use by language \"%2$s\"."
msgstr "El slug \"%1$s\" ja està en ús per l'idioma \"%2$s\"."

#, tp-ai, tp-glo-ee8b4f9f
msgid "TranslatePress rejected the new settings during sanitization."
msgstr "TranslatePress ha rebutjat la nova configuració durant el sanejament."

