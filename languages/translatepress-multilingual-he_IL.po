msgstr "הדומיין החזיר סטטוס HTTP %d."

msgid "Limit this menu item to the following languages"
msgstr "הגבל פריט תפריט זה לשפות הבאות"

msgid "All Languages"
msgstr "כל השפות"

msgid "Translator"
msgstr "מתרגם"

