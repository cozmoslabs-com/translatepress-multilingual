msgid "You do not have permission to manage TranslatePress settings."
msgstr "Du har ikke tilladelse til at administrere TranslatePress-indstillinger."

#, tp-ai
msgid ""
"Invalid language code. Allowed characters: A-Z, a-z, 0-9, hyphen, "
"underscore."
msgstr "Ugyldig sprogkode. Tilladte tegn: A-Z, a-z, 0-9, bindestreg, understregning."

#, tp-ai, tp-glo-ee8b4f9f
msgid "Language code \"%s\" is not recognized by TranslatePress."
msgstr "Sprogkoden \"%s\" genkendes ikke af TranslatePress."

