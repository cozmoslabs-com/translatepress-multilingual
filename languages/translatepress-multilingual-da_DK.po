msgstr ""
"Din nuværende licens tillader op til %d ekstra sprog. Opgrader eller "
"aktiver en Pro-licens for at tilføje flere."

#, tp-ai, tp-glo-ee8b4f9f
msgid "TranslatePress rejected the new language during settings sanitization."
msgstr "TranslatePress afviste det nye sprog under sanitering af indstillinger."

#, tp-ai, tp-glo-c6709f3f, tp-glo-ee8b4f9f, tp-glo-f7c8926f
msgid ""
"Enabling Automatic Translation with the TranslatePress AI engine requires "
"an active TranslatePress license. Activate a license first with "
"translatepress/set-license-key, or pass a different engine (e.g. "
"\"google_translate_v2\", \"deepl\")."
msgstr ""
"Aktivering af automatisk oversættelse med TranslatePress AI-motoren kræver "
"en aktiv TranslatePress-licens. Aktivér først en licens med "
"translatepress/set-license-key, eller angiv en anden motor (f.eks. "
"\"google_translate_v2\", \"deepl\")."

msgid "Your license key expired on %s."
msgstr "Din licensnøgle udløb den %s."

