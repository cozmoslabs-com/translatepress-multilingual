msgstr ""
"Code de langue invalide. Caractères autorisés : A-Z, a-z, 0-9, trait "
"d'union, tiret bas."

#, tp-ai, tp-glo-ee8b4f9f
msgid "Language code \"%s\" is not recognized by TranslatePress."
msgstr "Le code de langue \"%s\" n'est pas reconnu par TranslatePress."

#, tp-ai
