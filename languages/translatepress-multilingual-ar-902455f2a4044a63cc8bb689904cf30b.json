\u0628\u0639\u0627\u062f"],"Content Restriction Mode":["\u0648\u0636\u0639 \u062a\u0642\u064a\u064a\u062f \u0627\u0644\u0645\u062d\u062a\u0648\u0649"],"No languages selected":["\u0644\u0645 \u064a\u062a\u0645 \u062a\u062d\u062f\u064a\u062f \u0644\u063a\u0627\u062a"],"Saving...":["\u062c\u0627\u0631\u064a \u0627\u0644\u062d\u0641\u0638..."],"Saved!":["\u062a\u0645 \u0627\u0644\u062d\u0641\u0638!"],"Save changes":["\u062d\u0641\u0638 \u0627\u0644\u062a\u063a\u064a\u064a\u0631\u0627\u062a"],"Revert to last saved values":["\u0627\u0644\u0639\u0648\u062f\u0629 \u0625\u0644\u0649 \u0622\u062e\u0631 \u0642\u064a\u0645 \u0645\u062d\u0641\u0648\u0638\u0629"],"Revert changes":["\u0627\u0644\u062a\u0631\u0627\u062c\u0639 \u0639\u0646 \u0627\u0644\u062a\u063a\u064a\u064a\u0631\u0627\u062a"],"Restoring will revert to the last saved version and discard your current edits.":["\u0633\u062a\u0624\u062f\u064a \u0627\u0644\u0627\u0633\u062a\u0639\u0627\u062f\u0629 \u0625\u0644\u0649 \u0627\u0644\u0631\u062c\u0648\u0639 \u0625\u0644\u0649 \u0622\u062e\u0631 \u0646\u0633\u062e\u0629 \u0645\u062d\u0641\u0648\u0638\u0629 \u0648\u062a\u062c\u0627\u0647\u0644 \u062a\u0639\u062f\u064a\u0644\u0627\u062a\u0643 \u0627\u0644\u062d\u0627\u0644\u064a\u0629."],"Revert":["\u0627\u0633\u062a\u0639\u0627\u062f\u0629"],"Keep editing":["\u0645\u062a\u0627\u0628\u0639\u0629 \u0627\u0644\u062a\u0639\u062f\u064a\u0644"],"Are you sure you want to apply the <strong>%s<\/strong> preset?":["\u0647\u0644 \u0623\u0646\u062a \u0645\u062a\u0623\u0643\u062f \u0623\u0646\u0643 \u062a\u0631\u064a\u062f \u062a\u0637\u0628\u064a\u0642 \u0627\u0644\u0625\u0639\u062f\u0627\u062f \u0627\u0644\u0645\u0633\u0628\u0642 <strong>%s<\/strong>\u061f"],"It will override your current settings.":["\u0633\u064a\u0633\u062a\u0628\u062f\u0644 \u0625\u0639\u062f\u0627\u062f\u0627\u062a\u0643 \u0627\u0644\u062d\u0627\u0644\u064a\u0629."],"Apply preset":["\u062a\u0637\u0628\u064a\u0642 \u0627\u0644\u0625\u0639\u062f\u0627\u062f \u0627\u0644\u0645\u0633\u0628\u0642"],"Apply %s preset":["\u062a\u0637\u0628\u064a\u0642 \u0627\u0644\u0625\u0639\u062f\u0627\u062f \u0627\u0644\u0645\u0633\u0628\u0642 %s"],"Save failed":["\u0641\u0634\u0644 \u0627\u0644\u062d\u0641\u0638"],"Apply a preset":["\u062a\u0637\u0628\u064a\u0642 \u0625\u0639\u062f\u0627\u062f \u0645\u0633\u0628\u0642"],"Customize Design":["\u062a\u062e\u0635\u064a\u0635 \u0627\u0644\u062a\u0635\u0645\u064a\u0645"],"Background color":["\u0644\u0648\u0646 \u0627\u0644\u062e\u0644\u0641\u064a\u0629"],"Text color":["\u0644\u0648\u0646 \u0627\u0644\u0646\u0635"],"Enable custom CSS":["\u062a\u0641\u0639\u064a\u0644 CSS \u0645\u062e\u0635\u0635"],"Rectangle (4:3)":["\u0645\u0633\u062a\u0637\u064a\u0644 (\u0664:\u0663)"],"Square (1:1)":["\u0645\u0631\u0628\u0639 (\u0661:\u0661)"],"Switcher border width":["\u0639\u0631\u0636 \u062d\u062f\u0648\u062f \u0627\u0644\u0645\u0628\u062f\u0651\u0644"],"Switcher border radius":["\u0646\u0635\u0641 \u0642\u0637\u0631 \u062d\u062f\u0648\u062f \u0627\u0644\u0645\u0628\u062f\u0651\u0644"],"Hover over the language switcher to see it in action!":["\u0645\u0631\u0651\u0631 \u0645\u0624\u0634\u0631 \u0627\u0644\u0641\u0623\u0631\u0629 \u0641\u0648\u0642 \u0645\u0628\u062f\u0651\u0644 \u0627\u0644\u0644\u063a\u0629 \u0644\u062a\u0631\u0627\u0647 \u0642\u064a\u062f \u0627\u0644\u0639\u0645\u0644!"],"Switcher Preview":["\u0645\u0639\u0627\u064a\u0646\u0629 \u0645\u0628\u062f\u0651\u0644 \u0627\u0644\u0644\u063a\u0629"],"Enable Floating Switcher":["\u062a\u0641\u0639\u064a\u0644 \u0645\u0628\u062f\u0651\u0644 \u0627\u0644\u0644\u063a\u0629 \u0627\u0644\u0639\u0627\u0626\u0645"],"Switcher is enabled":["\u0645\u0628\u062f\u0651\u0644 \u0627\u0644\u0644\u063a\u0629 \u0645\u0641\u0639\u0651\u0644"],"Switcher is disabled":["\u0645\u0628\u062f\u0651\u0644 \u0627\u0644\u0644\u063a\u0629 \u0645\u0639\u0637\u0651\u0644"],"Switcher Type":["\u0646\u0648\u0639 \u0645\u0628\u062f\u0651\u0644 \u0627\u0644\u0644\u063a\u0629"],"Show languages as dropdown":["\u0639\u0631\u0636 \u0627\u0644\u0644\u063a\u0627\u062a \u0643\u0642\u0627\u0626\u0645\u0629 \u0645\u0646\u0633\u062f\u0644\u0629"],"Show languages side by side":["\u0639\u0631\u0636 \u0627\u0644\u0644\u063a\u0627\u062a \u0628\u062c\u0627\u0646\u0628 \u0628\u0639\u0636\u0647\u0627"],"Background hover color":["\u0644\u0648\u0646 \u0627\u0644\u062e\u0644\u0641\u064a\u0629 \u0639\u0646\u062f \u0627\u0644\u062a\u0645\u0631\u064a\u0631"],"Text hover color":["\u0644\u0648\u0646 \u0627\u0644\u0646\u0635 \u0639\u0646\u062f \u0627\u0644\u062a\u0645\u0631\u064a\u0631"],"Switcher border color":["\u0644\u0648\u0646 \u062d\u062f\u0648\u062f \u0627\u0644\u0645\u0628\u062f\u0651\u0644"],"Flag and text size":["\u062d\u062c\u0645 \u0627\u0644\u0639\u0644\u0645 \u0648\u0627\u0644\u0646\u0635"],"Flag icons shape":["\u0634\u0643\u0644 \u0623\u064a\u0642\u0648\u0646\u0627\u062a \u0627\u0644\u0623\u0639\u0644\u0627\u0645"],"Flag icons border radius":["\u0646\u0635\u0641 \u0642\u0637\u0631 \u062d\u062f\u0648\u062f \u0623\u064a\u0642\u0648\u0646\u0627\u062a \u0627\u0644\u0623\u0639\u0644\u0627\u0645"],"Customize Layout":["\u062a\u062e\u0635\u064a\u0635 \u0627\u0644\u062a\u062e\u0637\u064a\u0637"],"Show the small Powered by TranslatePress label in the language switcher.":["\u0625\u0638\u0647\u0627\u0631 \u0627\u0644\u062a\u0633\u0645\u064a\u0629 \u0627\u0644\u0635\u063a\u064a\u0631\u0629 \"\u0645\u062f\u0639\u0648\u0645 \u0628\u0648\u0627\u0633\u0637\u0629 TranslatePress\" \u0641\u064a \u0645\u0628\u062f\u0651\u0644 \u0627\u0644\u0644\u063a\u0629"],"You have unsaved changes. Leave anyway?":["\u0644\u062f\u064a\u0643 \u062a\u063a\u064a\u064a\u0631\u0627\u062a \u063a\u064a\u0631 \u0645\u062d\u0641\u0648\u0638\u0629. \u0647\u0644 \u062a\u0631\u064a\u062f \u0627\u0644\u0645\u063a\u0627\u062f\u0631\u0629 \u0639\u0644\u0649 \u0623\u064a \u062d\u0627\u0644\u061f"],"Switcher animations":["\u062d\u0631\u0643\u0627\u062a \u0627\u0644\u0645\u0628\u062f\u0651\u0644"],"Transforms the language switcher into a button showing the other available language, not the current one. <br> Only works when there are exactly two languages, the default one and a translation one.":["\u064a\u062d\u0648\u0651\u0644 \u0645\u0628\u062f\u0651\u0644 \u0627\u0644\u0644\u063a\u0629 \u0625\u0644\u0649 \u0632\u0631\u0651 \u064a\u0639\u0631\u0636 \u0627\u0644\u0644\u063a\u0629 \u0627\u0644\u0645\u062a\u0627\u062d\u0629 \u0627\u0644\u0623\u062e\u0631\u0649\u060c \u0648\u0644\u064a\u0633 \u0627\u0644\u062d\u0627\u0644\u064a\u0629. <br> \u064a\u0639\u0645\u0644 \u0641\u0642\u0637 \u0639\u0646\u062f\u0645\u0627 \u062a\u0643\u0648\u0646 \u0647\u0646\u0627\u0643 \u0644\u063a\u062a\u0627\u0646 \u0628\u0627\u0644\u0636\u0628\u0637\u060c \u0627\u0644\u0644\u063a\u0629 \u0627\u0644\u0627\u0641\u062a\u0631\u0627\u0636\u064a\u0629 \u0648\u0627\u0644\u0644\u063a\u0629 \u0627\u0644\u0645\u062a\u0631\u062c\u0645\u0629."],"This option only works when exactly two languages are published.":["\u064a\u0639\u0645\u0644 \u0647\u0630\u0627 \u0627\u0644\u062e\u064a\u0627\u0631 \u0641\u0642\u0637 \u0639\u0646\u062f\u0645\u0627 \u062a\u0643\u0648\u0646 \u0644\u063a\u062a\u0627\u0646 \u0645\u0646\u0634\u0648\u0631\u062a\u0627\u0646 \u0628\u0627\u0644\u0636\u0628\u0637."],"Copied!":["\u062a\u0645 \u0627\u0644\u0646\u0633\u062e!"],"Copy":["\u0646\u0633\u062e"],"Use shortcode on any page or widget. You can also add the Language Switcher Block in the WP Gutenberg Editor.":["\u0627\u0633\u062a\u062e\u062f\u0645 shortcode \u0641\u064a \u0623\u064a \u0635\u0641\u062d\u0629 \u0623\u0648 \u0639\u0646\u0635\u0631 \u0648\u0627\u062c\u0647\u0629. \u064a\u0645\u0643\u0646\u0643 \u0623\u064a\u0636\u064b\u0627 \u0625\u0636\u0627\u0641\u0629 \u0645\u0643\u0648\u0651\u0646 \u0645\u0628\u062f\u0651\u0644 \u0627\u0644\u0644\u063a\u0629 \u0641\u064a \u0645\u062d\u0631\u0651\u0631 Gutenberg \u0641\u064a \u0648\u0648\u0631\u062f\u0628\u0631\u064a\u0633."],"Shortcode":["shortcode"],"Additional Settings":["\u0625\u0639\u062f\u0627\u062f\u0627\u062a \u0625\u0636\u0627\u0641\u064a\u0629"],"Open the language switcher shortcode by clicking on it instead of hovering. <br> Close it by clicking on it, anywhere else on the screen or by pressing the escape key. <br> This will affect only the shortcode language switcher.":["\u0627\u0641\u062a\u062d shortcode \u0645\u0628\u062f\u0651\u0644 \u0627\u0644\u0644\u063a\u0629 \u0628\u0627\u0644\u0646\u0642\u0631 \u0639\u0644\u064a\u0647 \u0628\u062f\u0644 \u0627\u0644\u062a\u0645\u0631\u064a\u0631 \u0641\u0648\u0642\u0647. <br> \u0623\u063a\u0644\u0642\u0647 \u0628\u0627\u0644\u0646\u0642\u0631 \u0639\u0644\u064a\u0647\u060c \u0623\u0648 \u0641\u064a \u0623\u064a \u0645\u0643\u0627\u0646 \u0622\u062e\u0631 \u0639\u0644\u0649 \u0627\u0644\u0634\u0627\u0634\u0629\u060c \u0623\u0648 \u0628\u0627\u0644\u0636\u063a\u0637 \u0639\u0644\u0649 \u0645\u0641\u062a\u0627\u062d Escape. <br> \u0633\u064a\u0624\u062b\u0651\u0631 \u0647\u0630\u0627 \u0641\u0642\u0637 \u0639\u0644\u0649 shortcode \u0645\u0628\u062f\u0651\u0644 \u0627\u0644\u0644\u063a\u0629."],"Menu Switcher Layout":["\u062a\u062e\u0637\u064a\u0637 \u0645\u0628\u062f\u0651\u0644 \u0627\u0644\u0644\u063a\u0629 \u0641\u064a \u0627\u0644\u0642\u0627\u0626\u0645\u0629"],"Go to <a href=\"\/wp-admin\/nav-menus.php\">Appearance \u2192 Menus<\/a> to add languages to the Language Switcher in any menu.<br> <a href=\"https:\/\/translatepress.com\/docs\/settings\/language-switcher\/?utm_source=tp-language-switcher&utm_medium=client-site&utm_campaign=ls-menu-item#menu-switcher\" target=\"_blank\">Learn more in our documentation.<\/a>":["\u0627\u0646\u062a\u0642\u0644 \u0625\u0644\u0649 <a href=\"\/wp-admin\/nav-menus.php\">\u0627\u0644\u0645\u0638\u0647\u0631 \u2192 \u0627\u0644\u0642\u0648\u0627\u0626\u0645<\/a> \u0644\u0625\u0636\u0627\u0641\u0629 \u0644\u063a\u0627\u062a \u0625\u0644\u0649 \u0645\u0628\u062f\u0651\u0644 \u0627\u0644\u0644\u063a\u0629 \u0641\u064a \u0623\u064a \u0642\u0627\u0626\u0645\u0629.<br> <a href=\"https:\/\/translatepress.com\/docs\/settings\/language-switcher\/?utm_source=tp-language-switcher&utm_medium=client-site&utm_campaign=ls-menu-item#menu-switcher\" target=\"_blank\">\u0627\u0637\u0651\u0644\u0639 \u0639\u0644\u0649 \u0627\u0644\u0645\u0632\u064a\u062f \u0641\u064a \u062a\u0648\u062b\u064a\u0642\u0646\u0627.<\/a>"]}}}