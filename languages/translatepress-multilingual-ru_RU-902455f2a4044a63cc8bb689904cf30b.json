{"translation-revision-date":"2026-08-25 10:00:42+0000","generator":"WP-CLI\/2.12.0","source":"assets\/js\/trp-lang-switcher-configurator.js","domain":"messages","locale_data":{"messages":{"":{"domain":"messages","lang":"ru_RU","plural-forms":"nplurals=3; plural=(n%10==1 && n%100!=11 ? 0 : n%10>=2 && n%10<=4 && (n%100<10 || n%100>=20) ? 1 : 2);"},"Open language switcher only on click":["\u041e\u0442\u043a\u0440\u044b\u0442\u0438\u0435 \u043f\u0435\u0440\u0435\u043a\u043b\u044e\u0447\u0430\u0442\u0435\u043b\u044f \u044f\u0437\u044b\u043a\u043e\u0432 \u0442\u043e\u043b\u044c\u043a\u043e \u043f\u043e \u043d\u0430\u0436\u0430\u0442\u0438\u044e"],"Add":["\u0414\u043e\u0431\u0430\u0432\u0438\u0442\u044c"],"Select language":["\u0412\u044b\u0431\u0435\u0440\u0438\u0442\u0435 \u044f\u0437\u044b\u043a"],"Bottom Right":["\u0412\u043d\u0438\u0437\u0443 \u0441\u043f\u0440\u0430\u0432\u0430"],"Bottom Left":["\u0412\u043d\u0438\u0437\u0443 \u0441\u043b\u0435\u0432\u0430"],"Top Right":["\u0412\u0432\u0435\u0440\u0445\u0443 \u0441\u043f\u0440\u0430\u0432\u0430"],"Top Left":["\u0421\u0432\u0435\u0440\u0445\u0443 \u0441\u043b\u0435\u0432\u0430"],"Dark":["\u0422\u0451\u043c\u043d\u044b\u0439"],"Custom":["\u041f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u044c\u0441\u043a\u0438\u0439"],"Show opposite language":["\u041f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0442\u044c \u043f\u0440\u043e\u0442\u0438\u0432\u043e\u043f\u043e\u043b\u043e\u0436\u043d\u044b\u0439 \u044f\u0437\u044b\u043a"],"Normal":["\u041d\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u044b\u0439"],"Large":["\u041a\u0440\u0443\u043f\u043d\u044b\u0439"],"Cancel":["\u041e\u0442\u043c\u0435\u043d\u0430"],"Default":["\u041f\u043e \u0443\u043c\u043e\u043b\u0447\u0430\u043d\u0438\u044e"],"Border":["\u041a\u043e\u043d\u0442\u0443\u0440"],"Transparent":["\u041f\u0440\u043e\u0437\u0440\u0430\u0447\u043d\u044b\u0439"],"Show \"Powered by TranslatePress\"":["\u041e\u0442\u043e\u0431\u0440\u0430\u0436\u0430\u0442\u044c \u043f\u043e\u0434\u043f\u0438\u0441\u044c \u00ab\u0420\u0430\u0431\u043e\u0442\u0430\u0435\u0442 \u043d\u0430 TranslatePress\u00bb"],"Open colour picker":["\u041e\u0442\u043a\u0440\u044b\u0442\u044c \u043f\u0430\u043b\u0438\u0442\u0440\u0443 \u0446\u0432\u0435\u0442\u043e\u0432"],"Enabled":["\u0412\u043a\u043b\u044e\u0447\u0435\u043d\u043e"],"Disabled":["\u041e\u0442\u043a\u043b\u044e\u0447\u0435\u043d\u043e"],"Write custom CSS here...":["\u0412\u0432\u0435\u0434\u0438\u0442\u0435 \u0441\u0432\u043e\u0439 CSS \u0437\u0434\u0435\u0441\u044c..."],"Include":["\u0412\u043a\u043b\u044e\u0447\u0438\u0442\u044c"],"Exclude":["\u0418\u0441\u043a\u043b\u044e\u0447\u0438\u0442\u044c"],"Content Restriction Mode":["\u0420\u0435\u0436\u0438\u043c \u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0435\u043d\u0438\u044f \u0441\u043e\u0434\u0435\u0440\u0436\u0430\u043d\u0438\u044f"],"No languages selected":["\u042f\u0437\u044b\u043a\u0438 \u043d\u0435 \u0432\u044b\u0431\u0440\u0430\u043d\u044b"],"Saving...":["\u0421\u043e\u0445\u0440\u0430\u043d\u0435\u043d\u0438\u0435..."],"Saved!":["\u0421\u043e\u0445\u0440\u0430\u043d\u0435\u043d\u043e!"],"Save changes":["\u0421\u043e\u0445\u0440\u0430\u043d\u0438\u0442\u044c \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u044f"],"Revert to last saved values":["\u0412\u0435\u0440\u043d\u0443\u0442\u044c \u043a \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u043c \u0441\u043e\u0445\u0440\u0430\u043d\u0451\u043d\u043d\u044b\u043c \u0437\u043d\u0430\u0447\u0435\u043d\u0438\u044f\u043c"],"Revert changes":["\u041e\u0442\u043c\u0435\u043d\u0438\u0442\u044c \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u044f"],"Restoring will revert to the last saved version and discard your current edits.":["\u0412\u043e\u0441\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u0435 \u0432\u0435\u0440\u043d\u0451\u0442 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u044e\u044e \u0441\u043e\u0445\u0440\u0430\u043d\u0451\u043d\u043d\u0443\u044e \u0432\u0435\u0440\u0441\u0438\u044e \u0438 \u043e\u0442\u043c\u0435\u043d\u0438\u0442 \u0442\u0435\u043a\u0443\u0449\u0438\u0435 \u043f\u0440\u0430\u0432\u043a\u0438."],"Revert":["\u0412\u0435\u0440\u043d\u0443\u0442\u044c"],"Keep editing":["\u041f\u0440\u043e\u0434\u043e\u043b\u0436\u0438\u0442\u044c \u0440\u0435\u0434\u0430\u043a\u0442\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435"],"Are you sure you want to apply the <strong>%s<\/strong> preset?":["\u0412\u044b \u0443\u0432\u0435\u0440\u0435\u043d\u044b, \u0447\u0442\u043e \u0445\u043e\u0442\u0438\u0442\u0435 \u043f\u0440\u0438\u043c\u0435\u043d\u0438\u0442\u044c \u043f\u0440\u0435\u0434\u0443\u0441\u0442\u0430\u043d\u043e\u0432\u043a\u0443 <strong>%s<\/strong>?"],"It will override your current settings.":["\u0422\u0435\u043a\u0443\u0449\u0438\u0435 \u043d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0438 \u0431\u0443\u0434\u0443\u0442 \u043f\u0435\u0440\u0435\u0437\u0430\u043f\u0438\u0441\u0430\u043d\u044b."],"Apply preset":["\u041f\u0440\u0438\u043c\u0435\u043d\u0438\u0442\u044c \u043f\u0440\u0435\u0434\u0443\u0441\u0442\u0430\u043d\u043e\u0432\u043a\u0443"],"Apply %s preset":["\u041f\u0440\u0438\u043c\u0435\u043d\u0438\u0442\u044c \u043f\u0440\u0435\u0434\u0443\u0441\u0442\u0430\u043d\u043e\u0432\u043a\u0443 %s"],"Save failed":["\u0421\u043e\u0445\u0440\u0430\u043d\u0435\u043d\u0438\u0435 \u043d\u0435 \u0443\u0434\u0430\u043b\u043e\u0441\u044c"],"Apply a preset":["\u041f\u0440\u0438\u043c\u0435\u043d\u0438\u0442\u044c \u043f\u0440\u0435\u0434\u0443\u0441\u0442\u0430\u043d\u043e\u0432\u043a\u0443"],"Customize Design":["\u041d\u0430\u0441\u0442\u0440\u043e\u0438\u0442\u044c \u0434\u0438\u0437\u0430\u0439\u043d"],"Background color":["\u0426\u0432\u0435\u0442 \u0444\u043e\u043d\u0430"],"Text color":["\u0426\u0432\u0435\u0442 \u0442\u0435\u043a\u0441\u0442\u0430"],"Enable custom CSS":["\u0412\u043a\u043b\u044e\u0447\u0438\u0442\u044c \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u044c\u0441\u043a\u0438\u0439 CSS"],"Rectangle (4:3)":["\u041f\u0440\u044f\u043c\u043e\u0443\u0433\u043e\u043b\u044c\u043d\u0438\u043a (4:3)"],"Square (1:1)":["\u041a\u0432\u0430\u0434\u0440\u0430\u0442 (1:1)"],"Switcher border width":["\u0428\u0438\u0440\u0438\u043d\u0430 \u0433\u0440\u0430\u043d\u0438\u0446\u044b \u043f\u0435\u0440\u0435\u043a\u043b\u044e\u0447\u0430\u0442\u0435\u043b\u044f"],"Switcher border radius":["\u0420\u0430\u0434\u0438\u0443\u0441 \u0441\u043a\u0440\u0443\u0433\u043b\u0435\u043d\u0438\u044f \u043f\u0435\u0440\u0435\u043a\u043b\u044e\u0447\u0430\u0442\u0435\u043b\u044f"],"Hover over the language switcher to see it in action!":["\u041d\u0430\u0432\u0435\u0434\u0438\u0442\u0435 \u043a\u0443\u0440\u0441\u043e\u0440 \u043d\u0430 \u043f\u0435\u0440\u0435\u043a\u043b\u044e\u0447\u0430\u0442\u0435\u043b\u044c \u044f\u0437\u044b\u043a\u043e\u0432, \u0447\u0442\u043e\u0431\u044b \u0443\u0432\u0438\u0434\u0435\u0442\u044c \u0435\u0433\u043e \u0432 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0438!"],"Switcher Preview":["\u041f\u0440\u0435\u0434\u043f\u0440\u043e\u0441\u043c\u043e\u0442\u0440 \u043f\u0435\u0440\u0435\u043a\u043b\u044e\u0447\u0430\u0442\u0435\u043b\u044f"],"Enable Floating Switcher":["\u0412\u043a\u043b\u044e\u0447\u0438\u0442\u044c \u043f\u043b\u0430\u0432\u0430\u044e\u0449\u0438\u0439 \u043f\u0435\u0440\u0435\u043a\u043b\u044e\u0447\u0430\u0442\u0435\u043b\u044c"],"Switcher is enabled":["\u041f\u0435\u0440\u0435\u043a\u043b\u044e\u0447\u0430\u0442\u0435\u043b\u044c \u0432\u043a\u043b\u044e\u0447\u0451\u043d"],"Switcher is disabled":["\u041f\u0435\u0440\u0435\u043a\u043b\u044e\u0447\u0430\u0442\u0435\u043b\u044c \u043e\u0442\u043a\u043b\u044e\u0447\u0451\u043d"],"Switcher Type":["\u0422\u0438\u043f \u043f\u0435\u0440\u0435\u043a\u043b\u044e\u0447\u0430\u0442\u0435\u043b\u044f"],"Show languages as dropdown":["\u041f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0442\u044c \u044f\u0437\u044b\u043a\u0438 \u0432\u044b\u043f\u0430\u0434\u0430\u044e\u0449\u0438\u043c \u0441\u043f\u0438\u0441\u043a\u043e\u043c"],"Show languages side by side":["\u041f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0442\u044c \u044f\u0437\u044b\u043a\u0438 \u0440\u044f\u0434\u043e\u043c"],"Background hover color":["\u0426\u0432\u0435\u0442 \u0444\u043e\u043d\u0430 \u043f\u0440\u0438 \u043d\u0430\u0432\u0435\u0434\u0435\u043d\u0438\u0438"],"Text hover color":["\u0426\u0432\u0435\u0442 \u0442\u0435\u043a\u0441\u0442\u0430 \u043f\u0440\u0438 \u043d\u0430\u0432\u0435\u0434\u0435\u043d\u0438\u0438"],"Switcher border color":["\u0426\u0432\u0435\u0442 \u0433\u0440\u0430\u043d\u0438\u0446\u044b \u043f\u0435\u0440\u0435\u043a\u043b\u044e\u0447\u0430\u0442\u0435\u043b\u044f"],"Flag and text size":["\u0420\u0430\u0437\u043c\u0435\u0440 \u0444\u043b\u0430\u0433\u0430 \u0438 \u0442\u0435\u043a\u0441\u0442\u0430"],"Flag icons shape":["\u0424\u043e\u0440\u043c\u0430 \u0438\u043a\u043e\u043d\u043e\u043a \u0444\u043b\u0430\u0433\u043e\u0432"],"Flag icons border radius":["\u0420\u0430\u0434\u0438\u0443\u0441 \u0441\u043a\u0440\u0443\u0433\u043b\u0435\u043d\u0438\u044f \u0438\u043a\u043e\u043d\u043e\u043a \u0444\u043b\u0430\u0433\u043e\u0432"],"Customize Layout":["\u041d\u0430\u0441\u0442\u0440\u043e\u0438\u0442\u044c \u043c\u0430\u043a\u0435\u0442"],"Show the small Powered by TranslatePress label in the language switcher.":["\u041f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0442\u044c \u043d\u0435\u0431\u043e\u043b\u044c\u0448\u0443\u044e \u043c\u0435\u0442\u043a\u0443 Powered by TranslatePress \u0432 \u043f\u0435\u0440\u0435\u043a\u043b\u044e\u0447\u0430\u0442\u0435\u043b\u0435 \u044f\u0437\u044b\u043a\u043e\u0432."],"You have unsaved changes. Leave anyway?":["\u0423 \u0432\u0430\u0441 \u0435\u0441\u0442\u044c \u043d\u0435\u0441\u043e\u0445\u0440\u0430\u043d\u0451\u043d\u043d\u044b\u0435 \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u044f. \u0412\u0441\u0451 \u0440\u0430\u0432\u043d\u043e \u0443\u0439\u0442\u0438?"],"Switcher animations":["\u0410\u043d\u0438\u043c\u0430\u0446\u0438\u044f \u043f\u0435\u0440\u0435\u043a\u043b\u044e\u0447\u0430\u0442\u0435\u043b\u044f"],"Transforms the language switcher into a button showing the other available language, not the current one. <br> Only works when there are exactly two languages, the default one and a translation one.":["\u041f\u0440\u0435\u0432\u0440\u0430\u0449\u0430\u0435\u0442 \u043f\u0435\u0440\u0435\u043a\u043b\u044e\u0447\u0430\u0442\u0435\u043b\u044c \u044f\u0437\u044b\u043a\u043e\u0432 \u0432 \u043a\u043d\u043e\u043f\u043a\u0443, \u043e\u0442\u043e\u0431\u0440\u0430\u0436\u0430\u044e\u0449\u0443\u044e \u0434\u0440\u0443\u0433\u043e\u0439 \u0434\u043e\u0441\u0442\u0443\u043f\u043d\u044b\u0439 \u044f\u0437\u044b\u043a, \u0430 \u043d\u0435 \u0442\u0435\u043a\u0443\u0449\u0438\u0439. <br> \u0420\u0430\u0431\u043e\u0442\u0430\u0435\u0442 \u0442\u043e\u043b\u044c\u043a\u043e \u043f\u0440\u0438 \u043d\u0430\u043b\u0438\u0447\u0438\u0438 \u0440\u043e\u0432\u043d\u043e \u0434\u0432\u0443\u0445 \u044f\u0437\u044b\u043a\u043e\u0432: \u044f\u0437\u044b\u043a\u0430 \u043f\u043e \u0443\u043c\u043e\u043b\u0447\u0430\u043d\u0438\u044e \u0438 \u044f\u0437\u044b\u043a\u0430 \u043f\u0435\u0440\u0435\u0432\u043e\u0434\u0430."],"This option only works when exactly two languages are published.":["\u042d\u0442\u0430 \u043e\u043f\u0446\u0438\u044f \u0440\u0430\u0431\u043e\u0442\u0430\u0435\u0442 \u0442\u043e\u043b\u044c\u043a\u043e \u043f\u0440\u0438 \u043d\u0430\u043b\u0438\u0447\u0438\u0438 \u0440\u043e\u0432\u043d\u043e \u0434\u0432\u0443\u0445 \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043d\u043d\u044b\u0445 \u044f\u0437\u044b\u043a\u043e\u0432."],"Copied!":["\u0421\u043a\u043e\u043f\u0438\u0440\u043e\u0432\u0430\u043d\u043e!"],"Copy":["\u041a\u043e\u043f\u0438\u0440\u043e\u0432\u0430\u0442\u044c"],"Use shortcode on any page or widget. You can also add the Language Switcher Block in the WP Gutenberg Editor.":["\u0418\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0439\u0442\u0435 \u0448\u043e\u0440\u0442\u043a\u043e\u0434 \u043d\u0430 \u043b\u044e\u0431\u043e\u0439 \u0441\u0442\u0440\u0430\u043d\u0438\u0446\u0435 \u0438\u043b\u0438 \u0432 \u0432\u0438\u0434\u0436\u0435\u0442\u0435. \u0412\u044b \u0442\u0430\u043a\u0436\u0435 \u043c\u043e\u0436\u0435\u0442\u0435 \u0434\u043e\u0431\u0430\u0432\u0438\u0442\u044c \u0431\u043b\u043e\u043a \u043f\u0435\u0440\u0435\u043a\u043b\u044e\u0447\u0430\u0442\u0435\u043b\u044f \u044f\u0437\u044b\u043a\u043e\u0432 \u0432 \u0440\u0435\u0434\u0430\u043a\u0442\u043e\u0440\u0435 WP Gutenberg."],"Shortcode":["shortcode"],"Additional Settings":["\u0414\u043e\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0435 \u043d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0438"],"Open the language switcher shortcode by clicking on it instead of hovering. <br> Close it by clicking on it, anywhere else on the screen or by pressing the escape key. <br> This will affect only the shortcode language switcher.":["\u041e\u0442\u043a\u0440\u044b\u0432\u0430\u0442\u044c \u043f\u0435\u0440\u0435\u043a\u043b\u044e\u0447\u0430\u0442\u0435\u043b\u044c \u044f\u0437\u044b\u043a\u043e\u0432 \u043d\u0430 \u043e\u0441\u043d\u043e\u0432\u0435 \u0448\u043e\u0440\u0442\u043a\u043e\u0434\u0430 \u0449\u0435\u043b\u0447\u043a\u043e\u043c \u0432\u043c\u0435\u0441\u0442\u043e \u043d\u0430\u0432\u0435\u0434\u0435\u043d\u0438\u044f. <br> \u0417\u0430\u043a\u0440\u044b\u0432\u0430\u0442\u044c \u0435\u0433\u043e \u0449\u0435\u043b\u0447\u043a\u043e\u043c \u043f\u043e \u043d\u0435\u043c\u0443, \u0449\u0435\u043b\u0447\u043a\u043e\u043c \u0432 \u043b\u044e\u0431\u043e\u043c \u0434\u0440\u0443\u0433\u043e\u043c \u043c\u0435\u0441\u0442\u0435 \u044d\u043a\u0440\u0430\u043d\u0430 \u0438\u043b\u0438 \u043d\u0430\u0436\u0430\u0442\u0438\u0435\u043c \u043a\u043b\u0430\u0432\u0438\u0448\u0438 Escape. <br> \u042d\u0442\u043e \u043f\u043e\u0432\u043b\u0438\u044f\u0435\u0442 \u0442\u043e\u043b\u044c\u043a\u043e \u043d\u0430 \u043f\u0435\u0440\u0435\u043a\u043b\u044e\u0447\u0430\u0442\u0435\u043b\u044c \u044f\u0437\u044b\u043a\u043e\u0432 \u043d\u0430 \u043e\u0441\u043d\u043e\u0432\u0435 \u0448\u043e\u0440\u0442\u043a\u043e\u0434\u0430."],"Menu Switcher Layout":["\u041c\u0430\u043a\u0435\u0442 \u043f\u0435\u0440\u0435\u043a\u043b\u044e\u0447\u0430\u0442\u0435\u043b\u044f \u0432 \u043c\u0435\u043d\u044e"],"Go to <a href=\"\/wp-admin\/nav-menus.php\">Appearance \u2192 Menus<\/a> to add languages to the Language Switcher in any menu.<br> <a href=\"https:\/\/translatepress.com\/docs\/settings\/language-switcher\/?utm_source=tp-language-switcher&utm_medium=client-site&utm_campaign=ls-menu-item#menu-switcher\" target=\"_blank\">Learn more in our documentation.<\/a>":["\u041f\u0435\u0440\u0435\u0439\u0434\u0438\u0442\u0435 \u0432 \u0440\u0430\u0437\u0434\u0435\u043b <a href=\"\/wp-admin\/nav-menus.php\">\u0412\u043d\u0435\u0448\u043d\u0438\u0439 \u0432\u0438\u0434 \u2192 \u041c\u0435\u043d\u044e<\/a>, \u0447\u0442\u043e\u0431\u044b \u0434\u043e\u0431\u0430\u0432\u0438\u0442\u044c \u044f\u0437\u044b\u043a\u0438 \u0432 \u043f\u0435\u0440\u0435\u043a\u043b\u044e\u0447\u0430\u0442\u0435\u043b\u044c \u044f\u0437\u044b\u043a\u043e\u0432 \u0432 \u043b\u044e\u0431\u043e\u0435 \u043c\u0435\u043d\u044e.<br> <a href=\"https:\/\/translatepress.com\/docs\/settings\/language-switcher\/?utm_source=tp-language-switcher&utm_medium=client-site&utm_campaign=ls-menu-item#menu-switcher\" target=\"_blank\">\u041f\u043e\u0434\u0440\u043e\u0431\u043d\u0435\u0435 \u0432 \u043d\u0430\u0448\u0435\u0439 \u0434\u043e\u043a\u0443\u043c\u0435\u043d\u0442\u0430\u0446\u0438\u0438.<\/a>"]}}}