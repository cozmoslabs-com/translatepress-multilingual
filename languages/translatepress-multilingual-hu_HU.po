msgstr ""
"A WP Gutenberg szerkesztőben is hozzáadhatja a <a href=\"%s\" "
"title=\"Language Switcher Block Documentation\">Nyelvváltó blokkot</a>."

msgid "Menu item"
msgstr "Menüpont"

msgid ""
"Go to  %1$s Appearance -> Menus%2$s to add languages to the Language "
