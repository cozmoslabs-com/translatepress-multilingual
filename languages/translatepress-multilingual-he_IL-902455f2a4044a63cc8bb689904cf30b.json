ed":["\u05dc\u05d0 \u05e0\u05d1\u05d7\u05e8\u05d5 \u05e9\u05e4\u05d5\u05ea"],"Saving...":["\u05e9\u05d5\u05de\u05e8..."],"Saved!":["\u05e0\u05e9\u05de\u05e8!"],"Save changes":["\u05e9\u05de\u05d5\u05e8 \u05e9\u05d9\u05e0\u05d5\u05d9\u05d9\u05dd"],"Revert to last saved values":["\u05e9\u05d7\u05d6\u05e8 \u05dc\u05e2\u05e8\u05db\u05d9\u05dd \u05e9\u05e0\u05e9\u05de\u05e8\u05d5 \u05dc\u05d0\u05d7\u05e8\u05d5\u05e0\u05d4"],"Revert changes":["\u05e9\u05d7\u05d6\u05e8 \u05e9\u05d9\u05e0\u05d5\u05d9\u05d9\u05dd"],"Restoring will revert to the last saved version and discard your current edits.":["\u05d4\u05e9\u05d7\u05d6\u05d5\u05e8 \u05d9\u05d7\u05d6\u05d9\u05e8 \u05d0\u05ea \u05d4\u05d2\u05e8\u05e1\u05d4 \u05d4\u05d0\u05d7\u05e8\u05d5\u05e0\u05d4 \u05e9\u05e0\u05e9\u05de\u05e8\u05d4 \u05d5\u05d9\u05d1\u05d8\u05dc \u05d0\u05ea \u05d4\u05e2\u05e8\u05d9\u05db\u05d5\u05ea \u05d4\u05e0\u05d5\u05db\u05d7\u05d9\u05d5\u05ea \u05e9\u05dc\u05da."],"Revert":["\u05e9\u05d7\u05d6\u05d5\u05e8"],"Keep editing":["\u05d4\u05de\u05e9\u05da \u05e2\u05e8\u05d9\u05db\u05d4"],"Are you sure you want to apply the <strong>%s<\/strong> preset?":["\u05d4\u05d0\u05dd \u05d0\u05ea\u05d4 \u05d1\u05d8\u05d5\u05d7 \u05e9\u05d1\u05e8\u05e6\u05d5\u05e0\u05da \u05dc\u05d4\u05d7\u05d9\u05dc \u05d0\u05ea \u05d4\u05e2\u05e8\u05db\u05d4 \u05d4\u05e7\u05d1\u05d5\u05e2\u05d4 \u05de\u05e8\u05d0\u05e9 <strong>%s<\/strong>?"],"It will override your current settings.":["\u05d4\u05d9\u05d0 \u05ea\u05d3\u05e8\u05d5\u05e1 \u05d0\u05ea \u05d4\u05d4\u05d2\u05d3\u05e8\u05d5\u05ea \u05d4\u05e0\u05d5\u05db\u05d7\u05d9\u05d5\u05ea \u05e9\u05dc\u05da."],"Apply preset":["\u05d4\u05d7\u05dc \u05e2\u05e8\u05db\u05d4 \u05e7\u05d1\u05d5\u05e2\u05d4 \u05de\u05e8\u05d0\u05e9"],"Apply %s preset":["\u05d4\u05d7\u05dc \u05d0\u05ea \u05e2\u05e8\u05db\u05ea \u05d4\u05e2\u05d9\u05e6\u05d5\u05d1 %s"],"Save failed":["\u05d4\u05e9\u05de\u05d9\u05e8\u05d4 \u05e0\u05db\u05e9\u05dc\u05d4"],"Apply a preset":["\u05d4\u05d7\u05dc \u05e2\u05e8\u05d