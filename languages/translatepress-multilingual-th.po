msgstr "โดเมนส่งคืนสถานะ HTTP %d"

msgid "Limit this menu item to the following languages"
msgstr "จำกัดรายการเมนูนี้เฉพาะภาษาต่อไปนี้"

msgid "All Languages"
msgstr "ทุกภาษา"

msgid "Translator"
msgstr "ผู้แปล"

#, tp-glo-ee8b4f9f
msgid " TranslatePress Settings"
