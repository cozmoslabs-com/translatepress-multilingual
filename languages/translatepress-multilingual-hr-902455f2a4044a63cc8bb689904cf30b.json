{"translation-revision-date":"2026-03-27 09:00:36+0000","generator":"WP-CLI\/2.12.0","source":"assets\/js\/trp-lang-switcher-configurator.js","domain":"messages","locale_data":{"messages":{"":{"domain":"messages","lang":"hr","plural-forms":"nplurals=3; plural=(n%10==1 && n%100!=11 ? 0 : n%10>=2 && n%10<=4 && (n%100<10 || n%100>=20) ? 1 : 2);"},"Open language switcher only on click":["Otvori prekida\u010d jezika samo na klik"],"Add":["Dodaj"],"Select language":["Odaberite jezik"],"Bottom Right":["Dolje desno"],"Bottom Left":["Dolje lijevo"],"Top Right":["Gore desno"],"Top Left":["Gore lijevo"],"Dark":["Tamno"],"Custom":["Prilago\u0111eno"],"Show opposite language":["Prika\u017ei suprotan jezik"],"Normal":["Normalna"],"Large":["Velika"],"Cancel":["Otka\u017ei"],"Default":["Zadano"],"Border":["Rub"],"Transparent":["Transparentno"],"Show \"Powered by TranslatePress\"":["Prika\u017ei \"Pokre\u0107e TranslatePress\""],"Open colour picker":["Otvori bira\u010d boja"],"Enabled":["Omogu\u0107eno"],"Disabled":["Onemogu\u0107eno"],"Write custom CSS here...":["Ovdje napi\u0161ite prilago\u0111eni CSS..."],"Include":["Obuhva\u0107a"],"Exclude":["Izostavi"],"Content Restriction Mode":["Na\u010din ograni\u010denja sadr\u017eaja"],"No languages selected":["Nema odabranih jezika"],"Saving...":["Spremanje..."],"Saved!":["Spremljeno!"],"Save changes":["Spremi promjene"],"Revert to last saved values":["Vrati na posljednje spremljene vrijednosti"],"Revert changes":["Vrati promjene"],"Restoring will revert to the last saved version and discard your current edits.":["Vra\u0107anje vratit \u0107e na posljednju spremljenu verziju i odbaciti va\u0161e trenutne izmjene."],"Revert":["Vrati"],"Keep editing":["Nastavi ure\u0111ivati"],"Are you sure you want to apply the <strong>%s<\/strong> preset?":["Jeste li sigurni da \u017eelite primijeniti <strong>%s<\/strong> predlo\u017eak?"],"It will override your current settings.":["To \u0107e prepisati va\u0161e trenutne postavke."],"Apply preset":["Primijeni predlo\u017eak"],"Apply %s preset":["Primijeni %s predlo\u017eak"],"Save failed":["Spremanje nije uspjelo"],"Apply a preset":["Primijeni predlo\u017eak"],"Customize Design":["Prilagodi dizajn"],"Background color":["Boja pozadine"],"Text color":["Boja teksta"],"Enable custom CSS":["Omogu\u0107i prilago\u0111eni CSS"],"Rectangle (4:3)":["Pravokutnik (4:3)"],"Square (1:1)":["Kvadrat (1:1)"],"Switcher border width":["\u0160irina obruba prebaciva\u010da"],"Switcher border radius":["Polumjer obruba prebaciva\u010da"],"Hover over the language switcher to see it in action!":["Pre\u0111ite mi\u0161em preko mjenja\u010da jezika da biste ga vidjeli u akciji!"],"Switcher Preview":["Pretpregled prebaciva\u010da"],"Enable Floating Switcher":["Omogu\u0107i plutaju\u0107i prebaciva\u010d"],"Switcher is enabled":["Prebaciva\u010d je omogu\u0107en"],"Switcher is disabled":["Prebaciva\u010d je onemogu\u0107en"],"Switcher Type":["Vrsta prebaciva\u010da"],"Show languages as dropdown":["Prika\u017ei jezike kao padaju\u0107i izbornik"],"Show languages side by side":["Prika\u017ei jezike jedan pokraj drugog"],"Background hover color":["Boja pozadine pri prelasku"],"Text hover color":["Boja teksta pri prelasku"],"Switcher border color":["Boja obruba prebaciva\u010da"],"Flag and text size":["Veli\u010dina zastave i teksta"],"Flag icons shape":["Oblik ikona zastava"],"Flag icons border radius":["Polumjer obruba ikona zastava"],"Customize Layout":["Prilagodi izgled"],"Show the small Powered by TranslatePress label in the language switcher.":["Prika\u017ei malu oznaku Powered by TranslatePress u prebaciva\u010du jezika."],"You have unsaved changes. Leave anyway?":["Imate nespremljene promjene. Napustiti svejedno?"],"Switcher animations":["Animacije prebaciva\u010da"],"Transforms the language switcher into a button showing the other available language, not the current one. <br> Only works when there are exactly two languages, the default one and a translation one.":["Pretvara prebaciva\u010d jezika u gumb koji prikazuje drugi dostupni jezik, a ne trenutni. <br> Djeluje samo kada postoje to\u010dno dva jezika, zadani i prijevodni jezik."],"This option only works when exactly two languages are published.":["Ova opcija djeluje samo kada su objavljena to\u010dno dva jezika."],"Copied!":["Kopirano!"],"Copy":["Kopiraj"],"Use shortcode on any page or widget. You can also add the Language Switcher Block in the WP Gutenberg Editor.":["Koristite shortcode na bilo kojoj stranici ili widgetu. Tako\u0111er mo\u017eete dodati blok prebaciva\u010da jezika u WP Gutenberg ure\u0111iva\u010du."],"Shortcode":["Shortcode"],"Additional Settings":["Dodatne postavke"],"Open the language switcher shortcode by clicking on it instead of hovering. <br> Close it by clicking on it, anywhere else on the screen or by pressing the escape key. <br> This will affect only the shortcode language switcher.":["Otvorite prebaciva\u010d jezika u shortcodeu klikom umjesto prelaskom mi\u0161em. <br> Zatvorite ga klikom na njega, bilo gdje drugdje na zaslonu ili pritiskom tipke Escape. <br> Ovo utje\u010de samo na prebaciva\u010d jezika u shortcodeu."],"Menu Switcher Layout":["Izgled prebaciva\u010da u izborniku"],"Go to <a href=\"\/wp-admin\/nav-menus.php\">Appearance \u2192 Menus<\/a> to add languages to the Language Switcher in any menu.<br> <a href=\"https:\/\/translatepress.com\/docs\/settings\/language-switcher\/?utm_source=tp-language-switcher&utm_medium=client-site&utm_campaign=ls-menu-item#menu-switcher\" target=\"_blank\">Learn more in our documentation.<\/a>":["Idite na <a href=\"\/wp-admin\/nav-menus.php\">Izgled \u2192 Izbornici<\/a> da biste dodali jezike u prebaciva\u010d jezika u bilo kojem izborniku.<br> <a href=\"https:\/\/translatepress.com\/docs\/settings\/language-switcher\/?utm_source=tp-language-switcher&utm_medium=client-site&utm_campaign=ls-menu-item#menu-switcher\" target=\"_blank\">Saznajte vi\u0161e u na\u0161oj dokumentaciji.<\/a>"]}}}