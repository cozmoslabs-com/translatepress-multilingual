3d\u0430 \u0446\u0432\u044f\u0442"],"Enabled":["\u0412\u043a\u043b\u044e\u0447\u0435\u043d\u043e"],"Disabled":["\u0418\u0437\u043a\u043b\u044e\u0447\u0435\u043d\u043e"],"Write custom CSS here...":["\u041d\u0430\u043f\u0438\u0448\u0435\u0442\u0435 \u043f\u0435\u0440\u0441\u043e\u043d\u0430\u043b\u0438\u0437\u0438\u0440\u0430\u043d CSS \u0442\u0443\u043a..."],"Include":["\u0412\u043a\u043b\u044e\u0447\u0432\u0430\u043d\u0435"],"Exclude":["\u0418\u0437\u043a\u043b\u044e\u0447\u0432\u0430\u043d\u0435"],"Content Restriction Mode":["\u0420\u0435\u0436\u0438\u043c \u043d\u0430 \u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0430\u0432\u0430\u043d\u0435 \u043d\u0430 \u0441\u044a\u0434\u044a\u0440\u0436\u0430\u043d\u0438\u0435\u0442\u043e"],"No languages selected":["\u041d\u044f\u043c\u0430 \u0438\u0437\u0431\u0440\u0430\u043d\u0438 \u0435\u0437\u0438\u0446\u0438"],"Saving...":["\u0417\u0430\u043f\u0430\u0437\u0432\u0430\u043d\u0435..."],"Saved!":["\u0417\u0430\u043f\u0430\u0437\u0435\u043d\u043e!"],"Save changes":["\u0417\u0430\u043f\u0430\u0437\u0432\u0430\u043d\u0435 \u043d\u0430 \u043f\u0440\u043e\u043c\u0435\u043d\u0438\u0442\u0435"],"Revert to last saved values":["\u0412\u044a\u0437\u0441\u0442\u0430\u043d\u043e\u0432\u044f\u0432\u0430\u043d\u0435 \u043d\u0430 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u043e \u0437\u0430\u043f\u0430\u0437\u0435\u043d\u0438\u0442\u0435 \u0441\u0442\u043e\u0439\u043d\u043e\u0441\u0442\u0438"],"Revert changes":["\u0412\u044a\u0437\u0441\u0442\u0430\u043d\u043e\u0432\u044f\u0432\u0430\u043d\u0435 \u043d\u0430 \u043f\u0440\u043e\u043c\u0435\u043d\u0438\u0442\u0435"],"Restoring will revert to the last saved version and discard your current edits.":["\u0412\u044a\u0437\u0441\u0442\u0430\u043d\u043e\u0432\u044f\u0432\u0430\u043d\u0435\u0442\u043e \u0449\u0435 \u0432\u044a\u0440\u043d\u0435 \u043a\u044a\u043c \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u043e \u0437\u0430\u043f\u0430\u0437\u0435\u043d\u0430\u0442\u0430 \u0432\u0435\u0440\u0441\u0438\u044f \u0438 \u0449\u0435 \u043e\u0442\u0445\u0432\u044a\u0440\u043b\u0438 \u0442\u0435\u043a\u0443\u0449\u0438\u0442\u0435 \u0432\u0438 \u0440\u0435\u0434\u0430\u043a\u0446\u0438\u0438."],"Revert":["\u0412\u044a\u0437\u0441\u0442\u0430\u043d\u043e\u0432\u0438"],"Keep editing":["\u041f\u0440\u043e\u0434\u044a\u043b\u0436\u0438 \u0440\u0435\u0434\u0430\u043a\u0442\u0438\u0440\u0430\u043d\u0435\u0442\u043e"],"Are you sure you want to apply the <strong>%s<\/strong> preset?":["\u0421\u0438\u0433\u0443\u0440\u043d\u0438 \u043b\u0438 \u0441\u0442\u0435, \u0447\u0435 \u0438\u0441\u043a\u0430\u0442\u0435 \u0434\u0430 \u043f\u0440\u0438\u043b\u043e\u0436\u0438\u0442\u0435 \u043f\u0440\u0435\u0434\u0432\u0430\u0440\u0438\u0442\u0435\u043b\u043d\u0430\u0442\u0430 \u043d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0430 <strong>%s<\/strong>?"],"It will override your current settings.":["\u0422\u043e\u0432\u0430 \u0449\u0435 \u0437\u0430\u043c\u0435\u043d\u0438 \u0442\u0435\u043a\u0443\u0449\u0438\u0442\u0435 \u0432\u0438 \u043d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0438."],"Apply preset":["\u041f\u0440\u0438\u043b\u043e\u0436\u0438 \u043f\u0440\u0435\u0434\u0432\u0430\u0440\u0438\u0442\u0435\u043b\u043d\u0430 \u043d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0430"],"Apply %s preset":["\u041f\u0440\u0438\u043b\u043e\u0436\u0438 %s \u043f\u0440\u0435\u0434\u0432\u0430\u0440\u0438\u0442\u0435\u043b\u043d\u0430 \u043d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0430"],"Save failed":["\u0417\u0430\u043f\u0430\u0437\u0432\u0430\u043d\u0435\u0442\u043e \u043d\u0435 \u0431\u0435 \u0443\u0441\u043f\u0435\u0448\u043d\u043e"],"Apply a preset":["\u041f\u0440\u0438\u043b\u043e\u0436\u0438 \u043f\u0440\u0435\u0434\u0432\u0430\u0440\u0438\u0442\u0435\u043b\u043d\u0430 \u043d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0430"],"Customize Design":["\u041f\u0435\u0440\u0441\u043e\u043d\u0430\u043b\u0438\u0437\u0438\u0440\u0430\u0439 \u0434\u0438\u0437\u0430\u0439\u043d\u0430"],"Background color":["\u0426\u0432\u044f\u0442 \u043d\u0430 \u0444\u043e\u043d\u0430"],"Text color":["\u0426\u0432\u044f\u0442 \u043d\u0430 \u0442\u0435\u043a\u0441\u0442\u0430"],"Enable custom CSS":["\u0412\u043a\u043b\u044e\u0447\u0432\u0430\u043d\u0435 \u043d\u0430 \u043f\u0435\u0440\u0441\u043e\u043d\u0430\u043b\u0438\u0437\u0438\u0440\u0430\u043d CSS"],"Rectangle (4:3)":["\u041f\u0440\u0430\u0432\u043e\u044a\u0433\u044a\u043b\u043d\u0438\u043a (4:3)"],"Square (1:1)":["\u041a\u0432\u0430\u0434\u0440\u0430\u0442 (1:1)"],"Switcher border width":["\u0414\u0435\u0431\u0435\u043b\u0438\u043d\u0430 \u043d\u0430 \u0440\u0430\u043c\u043a\u0430\u0442\u0430 \u043d\u0430 \u043f\u0440\u0435\u0432\u043a\u043b\u044e\u0447\u0432\u0430\u0442\u0435\u043b\u044f"],"Switcher border radius":["\u0420\u0430\u0434\u0438\u0443\u0441 \u043d\u0430 \u0440\u0430\u043c\u043a\u0430\u0442\u0430 \u043d\u0430 \u043f\u0440\u0435\u0432\u043a\u043b\u044e\u0447\u0432\u0430\u0442\u0435\u043b\u044f"],"Hover over the language switcher to see it in action!":["\u041f\u043e\u0441\u043e\u0447\u0435\u0442\u0435 \u0441 \u043c\u0438\u0448\u043a\u0430\u0442\u0430 \u0435\u0437\u0438\u043a\u043e\u0432\u0438\u044f \u043f\u0440\u0435\u0432\u043a\u043b\u044e\u0447\u0432\u0430\u0442\u0435\u043b, \u0437\u0430 \u0434\u0430 \u0433\u043e \u0432\u0438\u0434\u0438\u0442\u0435 \u0432 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435!"],"Switcher Preview":["\u041f\u0440\u0435\u0433\u043b\u0435\u0434 \u043d\u0430 \u043f\u0440\u0435\u0432\u043a\u043b\u044e\u0447\u0432\u0430\u0442\u0435\u043b\u044f"],"Enable Floating Switcher":["\u0410\u043a\u0442\u0438\u0432\u0438\u0440\u0430\u043d\u0435 \u043d\u0430 \u043f\u043b\u0430\u0432\u0430\u0449\u0438\u044f \u043f\u0440\u0435\u0432\u043a\u043b\u044e\u0447\u0432\u0430\u0442\u0435\u043b"],"Switcher is enabled":["\u041f\u0440\u0435\u0432\u043a\u043b\u044e\u0447\u0432\u0430\u0442\u0435\u043b\u044f\u0442 \u0435 \u0430\u043a\u0442\u0438\u0432\u0438\u0440\u0430\u043d"],"Switcher is disabled":["\u041f\u0440\u0435\u0432\u043a\u043b\u044e\u0447\u0432\u0430\u0442\u0435\u043b\u044f\u0442 \u0435 \u0434\u0435\u0430\u043a\u0442\u0438\u0432\u0438\u0440\u0430\u043d"],"Switcher Type":["\u0422\u0438\u043f \u043f\u0440\u0435\u0432\u043a\u043b\u044e\u0447\u0432\u0430\u0442\u0435\u043b"],"Show languages as dropdown":["\u041f\u043e\u043a\u0430\u0437\u0432\u0430\u043d\u0435 \u043d\u0430 \u0435\u0437\u0438\u0446\u0438\u0442\u0435 \u043a\u0430\u0442\u043e \u043f\u0430\u0434\u0430\u0449\u043e \u043c\u0435\u043d\u044e"],"Show languages side by side":["\u041f\u043e\u043a\u0430\u0437\u0432\u0430\u043d\u0435 \u043d\u0430 \u0435\u0437\u0438\u0446\u0438\u0442\u0435 \u0435\u0434\u0438\u043d \u0434\u043e \u0434\u0440\u0443\u0433"],"Background hover color":["\u0426\u0432\u044f\u0442 \u043d\u0430 \u0444\u043e\u043d\u0430 \u043f\u0440\u0438 \u043f\u043e\u0441\u043e\u0447\u0432\u0430\u043d\u0435"],"Text hover color":["\u0426\u0432\u044f\u0442 \u043d\u0430 \u0442\u0435\u043a\u0441\u0442\u0430 \u043f\u0440\u0438 \u043f\u043e\u0441\u043e\u0447\u0432\u0430\u043d\u0435"],"Switcher border color":["\u0426\u0432\u044f\u0442 \u043d\u0430 \u0440\u0430\u043c\u043a\u0430\u0442\u0430 \u043d\u0430 \u043f\u0440\u0435\u0432\u043a\u043b\u044e\u0447\u0432\u0430\u0442\u0435\u043b\u044f"],"Flag and text size":["\u0420\u0430\u0437\u043c\u0435\u0440 \u043d\u0430 \u0444\u043b\u0430\u0433\u0430 \u0438 \u0442\u0435\u043a\u0441\u0442\u0430"],"Flag icons shape":["\u0424\u043e\u0440\u043c\u0430 \u043d\u0430 \u0438\u043a\u043e\u043d\u0438\u0442\u0435 \u043d\u0430 \u0444\u043b\u0430\u0433\u043e\u0432\u0435\u0442\u0435"],"Flag icons border radius":["\u0420\u0430\u0434\u0438\u0443\u0441 \u043d\u0430 \u0440\u0430\u043c\u043a\u0430\u0442\u0430 \u043d\u0430 \u0438\u043a\u043e\u043d\u0438\u0442\u0435 \u043d\u0430 \u0444\u043b\u0430\u0433\u043e\u0432\u0435\u0442\u0435"],"Customize Layout":["\u041f\u0435\u0440\u0441\u043e\u043d\u0430\u043b\u0438\u0437\u0438\u0440\u0430\u043d\u0435 \u043d\u0430 \u043e\u0444\u043e\u0440\u043c\u043b\u0435\u043d\u0438\u0435\u0442\u043e"],"Show the small Powered by TranslatePress label in the language switcher.":["\u041f\u043e\u043a\u0430\u0437\u0432\u0430\u043d\u0435 \u043d\u0430 \u043c\u0430\u043b\u043a\u0438\u044f \u0435\u0442\u0438\u043a\u0435\u0442 \u0417\u0430\u0434\u0432\u0438\u0436\u0432\u0430\u043d\u043e \u043e\u0442 TranslatePress \u0432 \u043f\u0440\u0435\u0432\u043a\u043b\u044e\u0447\u0432\u0430\u0442\u0435\u043b\u044f \u043d\u0430 \u0435\u0437\u0438\u043a\u0430."],"You have unsaved changes. Leave anyway?":["\u0418\u043c\u0430\u0442\u0435 \u043d\u0435\u0437\u0430\u043f\u0430\u0437\u0435\u043d\u0438 \u043f\u0440\u043e\u043c\u0435\u043d\u0438. \u0414\u0430 \u0441\u0435 \u0438\u0437\u043b\u0435\u0437\u0435 \u0432\u0441\u0435 \u043f\u0430\u043a?"],"Switcher animations":["\u0410\u043d\u0438\u043c\u0430\u0446\u0438\u0438 \u043d\u0430 \u043f\u0440\u0435\u0432\u043a\u043b\u044e\u0447\u0432\u0430\u0442\u0435\u043b\u044f"],"Transforms the language switcher into a button showing the other available language, not the current one. <br> Only works when there are exactly two languages, the default one and a translation one.":["\u041f\u0440\u0435\u043e\u0431\u0440\u0430\u0437\u0443\u0432\u0430 \u043f\u0440\u0435\u0432\u043a\u043b\u044e\u0447\u0432\u0430\u0442\u0435\u043b\u044f \u043d\u0430 \u0435\u0437\u0438\u043a\u0430 \u0432 \u0431\u0443\u0442\u043e\u043d, \u043f\u043e\u043a\u0430\u0437\u0432\u0430\u0449 \u0434\u0440\u0443\u0433\u0438\u044f \u043d\u0430\u043b\u0438\u0447\u0435\u043d \u0435\u0437\u0438\u043a, \u0430 \u043d\u0435 \u0442\u0435\u043a\u0443\u0449\u0438\u044f. <br> \u0420\u0430\u0431\u043e\u0442\u0438 \u0441\u0430\u043c\u043e \u043a\u043e\u0433\u0430\u0442\u043e \u0438\u043c\u0430 \u0442\u043e\u0447\u043d\u043e \u0434\u0432\u0430 \u0435\u0437\u0438\u043a\u0430 \u2013 \u043f\u043e \u043f\u043e\u0434\u0440\u0430\u0437\u0431\u0438\u0440\u0430\u043d\u0435 \u0438 \u043f\u0440\u0435\u0432\u0435\u0434\u0435\u043d."],"This option only works when exactly two languages are published.":["\u0422\u0430\u0437\u0438 \u043e\u043f\u0446\u0438\u044f \u0440\u0430\u0431\u043e\u0442\u0438 \u0441\u0430\u043c\u043e \u043a\u043e\u0433\u0430\u0442\u043e \u0441\u0430 \u043f\u0443\u0431\u043b\u0438\u043a\u0443\u0432\u0430\u043d\u0438 \u0442\u043e\u0447\u043d\u043e \u0434\u0432\u0430 \u0435\u0437\u0438\u043a\u0430."],"Copied!":["\u041a\u043e\u043f\u0438\u0440\u0430\u043d\u043e!"],"Copy":["\u041a\u043e\u043f\u0438\u0440\u0430\u0439"],"Use shortcode on any page or widget. You can also add the Language Switcher Block in the WP Gutenberg Editor.":["\u0418\u0437\u043f\u043e\u043b\u0437\u0432\u0430\u0439\u0442\u0435 shortcode \u043d\u0430 \u0432\u0441\u044f\u043a\u0430 \u0441\u0442\u0440\u0430\u043d\u0438\u0446\u0430 \u0438\u043b\u0438 \u0432 \u0434\u0436\u0430\u0434\u0436\u0430. \u041c\u043e\u0436\u0435\u0442\u0435 \u0441\u044a\u0449\u043e \u0434\u0430 \u0434\u043e\u0431\u0430\u0432\u0438\u0442\u0435 \u0431\u043b\u043e\u043a\u0430 \u041f\u0440\u0435\u0432\u043a\u043b\u044e\u0447\u0432\u0430\u0442\u0435\u043b \u043d\u0430 \u0435\u0437\u0438\u043a\u0430 \u0432 \u0440\u0435\u0434\u0430\u043a\u0442\u043e\u0440\u0430 Gutenberg \u043d\u0430 WP."],"Shortcode":["shortcode"],"Additional Settings":["\u0414\u043e\u043f\u044a\u043b\u043d\u0438\u0442\u0435\u043b\u043d\u0438 \u043d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0438"],"Open the language switcher shortcode by clicking on it instead of hovering. <br> Close it by clicking on it, anywhere else on the screen or by pressing the escape key. <br> This will affect only the shortcode language switcher.":["\u041e\u0442\u0432\u043e\u0440\u0435\u0442\u0435 \u043f\u0440\u0435\u0432\u043a\u043b\u044e\u0447\u0432\u0430\u0442\u0435\u043b\u044f \u043d\u0430 \u0435\u0437\u0438\u043a\u0430, \u0434\u043e\u0431\u0430\u0432\u0435\u043d \u0447\u0440\u0435\u0437 shortcode, \u0441 \u043a\u043b\u0438\u043a\u0432\u0430\u043d\u0435 \u0432\u044a\u0440\u0445\u0443 \u043d\u0435\u0433\u043e, \u0432\u043c\u0435\u0441\u0442\u043e \u0441 \u043f\u043e\u0441\u043e\u0447\u0432\u0430\u043d\u0435. <br> \u0417\u0430\u0442\u0432\u043e\u0440\u0435\u0442\u0435 \u0433\u043e \u0441 \u043a\u043b\u0438\u043a\u0432\u0430\u043d\u0435 \u0432\u044a\u0440\u0445\u0443 \u043d\u0435\u0433\u043e, \u043d\u044f\u043a\u044a\u0434\u0435 \u0434\u0440\u0443\u0433\u0430\u0434\u0435 \u043d\u0430 \u0435\u043a\u0440\u0430\u043d\u0430 \u0438\u043b\u0438 \u0441 \u043d\u0430\u0442\u0438\u0441\u043a\u0430\u043d\u0435 \u043d\u0430 \u043a\u043b\u0430\u0432\u0438\u0448\u0430 Escape. <br> \u0422\u043e\u0432\u0430 \u0449\u0435 \u0437\u0430\u0441\u0435\u0433\u043d\u0435 \u0441\u0430\u043c\u043e \u043f\u0440\u0435\u0432\u043a\u043b\u044e\u0447\u0432\u0430\u0442\u0435\u043b\u044f \u043d\u0430 \u0435\u0437\u0438\u043a\u0430, \u0434\u043e\u0431\u0430\u0432\u0435\u043d \u0447\u0440\u0435\u0437 shortcode."],"Menu Switcher Layout":["\u041e\u0444\u043e\u0440\u043c\u043b\u0435\u043d\u0438\u0435 \u043d\u0430 \u043f\u0440\u0435\u0432\u043a\u043b\u044e\u0447\u0432\u0430\u0442\u0435\u043b\u044f \u0432 \u043c\u0435\u043d\u044e\u0442\u043e"],"Go to <a href=\"\/wp-admin\/nav-menus.php\">Appearance \u2192 Menus<\/a> to add languages to the Language Switcher in any menu.<br> <a href=\"https:\/\/translatepress.com\/docs\/settings\/language-switcher\/?utm_source=tp-language-switcher&utm_medium=client-site&utm_campaign=ls-menu-item#menu-switcher\" target=\"_blank\">Learn more in our documentation.<\/a>":["\u041e\u0442\u0438\u0434\u0435\u0442\u0435 \u043d\u0430 <a href=\"\/wp-admin\/nav-menus.php\">\u0412\u044a\u043d\u0448\u0435\u043d \u0432\u0438\u0434 \u2192 \u041c\u0435\u043d\u044e\u0442\u0430<\/a>, \u0437\u0430 \u0434\u0430 \u0434\u043e\u0431\u0430\u0432\u0438\u0442\u0435 \u0435\u0437\u0438\u0446\u0438 \u043a\u044a\u043c \u043f\u0440\u0435\u0432\u043a\u043b\u044e\u0447\u0432\u0430\u0442\u0435\u043b\u044f \u043d\u0430 \u0435\u0437\u0438\u043a\u0430 \u0432\u044a\u0432 \u0432\u0441\u044f\u043a\u043e \u043c\u0435\u043d\u044e.<br> <a href=\"https:\/\/translatepress.com\/docs\/settings\/language-switcher\/?utm_source=tp-language-switcher&utm_medium=client-site&utm_campaign=ls-menu-item#menu-switcher\" target=\"_blank\">\u041d\u0430\u0443\u0447\u0435\u0442\u0435 \u043f\u043e\u0432\u0435\u0447\u0435 \u0432 \u043d\u0430\u0448\u0430\u0442\u0430 \u0434\u043e\u043a\u0443\u043c\u0435\u043d\u0442\u0430\u0446\u0438\u044f.<\/a>"]}}}