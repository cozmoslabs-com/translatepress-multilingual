"Enabled":["\u0395\u03bd\u03b5\u03c1\u03b3\u03bf\u03c0\u03bf\u03b9\u03b7\u03bc\u03ad\u03bd\u03bf"],"Disabled":["\u0391\u03c0\u03b5\u03bd\u03b5\u03c1\u03b3\u03bf\u03c0\u03bf\u03b9\u03b7\u03bc\u03ad\u03bd\u03bf"],"Write custom CSS here...":["\u0393\u03c1\u03ac\u03c8\u03c4\u03b5 \u03c0\u03c1\u03bf\u03c3\u03b1\u03c1\u03bc\u03bf\u03c3\u03bc\u03ad\u03bd\u03bf CSS \u03b5\u03b4\u03ce..."],"Include":["\u03a3\u03c5\u03bc\u03c0\u03b5\u03c1\u03af\u03bb\u03b7\u03c8\u03b7"],"Exclude":["\u0395\u03be\u03b1\u03af\u03c1\u03b5\u03c3\u03b7"],"Content Restriction Mode":["\u039b\u03b5\u03b9\u03c4\u03bf\u03c5\u03c1\u03b3\u03af\u03b1 \u03a0\u03b5\u03c1\u03b9\u03bf\u03c1\u03b9\u03c3\u03bc\u03bf\u03cd \u03a0\u03b5\u03c1\u03b9\u03b5\u03c7\u03bf\u03bc\u03ad\u03bd\u03bf\u03c5"],"No languages selected":["\u0394\u03b5\u03bd \u03ad\u03c7\u03bf\u03c5\u03bd \u03b5\u03c0\u03b9\u03bb\u03b5\u03b3\u03b5\u03af \u03b3\u03bb\u03ce\u03c3\u03c3\u03b5\u03c2"],"Saving...":["\u0391\u03c0\u03bf\u03b8\u03ae\u03ba\u03b5\u03c5\u03c3\u03b7..."],"Saved!":["\u0391\u03c0\u03bf\u03b8\u03b7\u03ba\u03b5\u03cd\u03c4\u03b7\u03ba\u03b5!"],"Save changes":["\u0391\u03c0\u03bf\u03b8\u03ae\u03ba\u03b5\u03c5\u03c3\u03b7 \u03b1\u03bb\u03bb\u03b1\u03b3\u03ce\u03bd"],"Revert to last saved values":["\u0395\u03c0\u03b1\u03bd\u03b1\u03c6\u03bf\u03c1\u03ac \u03c3\u03c4\u03b9\u03c2 \u03c4\u03b5\u03bb\u03b5\u03c5\u03c4\u03b1\u03af\u03b5\u03c2 \u03b1\u03c0\u03bf\u03b8\u03b7\u03ba\u03b5\u03c5\u03bc\u03ad\u03bd\u03b5\u03c2 \u03c4\u03b9\u03bc\u03ad\u03c2"],"Revert changes":["\u0395\u03c0\u03b1\u03bd\u03b1\u03c6\u03bf\u03c1\u03ac \u03b1\u03bb\u03bb\u03b1\u03b3\u03ce\u03bd"],"Restoring will revert to the last saved version and discard your current edits.":["\u0397 \u03b5\u03c0\u03b1\u03bd\u03b1\u03c6\u03bf\u03c1\u03ac \u03b8\u03b1 \u03b5\u03c0\u03b1\u03bd\u03b1\u03c6\u03ad\u03c1\u03b5\u03b9 \u03c4\u03b7\u03bd \u03c4\u03b5\u03bb\u03b5\u03c5\u03c4\u03b1\u03af\u03b1 \u03b1\u03c0\u03bf\u03b8\u03b7\u03ba\u03b5\u03c5\u03bc\u03ad\u03bd\u03b7 \u03ad\u03ba\u03b4\u03bf\u03c3\u03b7 \u03ba\u03b1\u03b9 \u03b8\u03b1 \u03b1\u03c0\u03bf\u03c1\u03c1\u03af\u03c8\u03b5\u03b9 \u03c4\u03b9\u03c2 \u03c4\u03c1\u03ad\u03c7\u03bf\u03c5\u03c3\u03b5\u03c2 \u03b5\u03c0\u03b5\u03be\u03b5\u03c1\u03b3\u03b1\u03c3\u03af\u03b5\u03c2 \u03c3\u03b1\u03c2."],"Revert":["\u0395\u03c0\u03b1\u03bd\u03b1\u03c6\u03bf\u03c1\u03ac"],"Keep editing":["\u03a3\u03c5\u03bd\u03ad\u03c7\u03b5\u03b9\u03b1 \u03b5\u03c0\u03b5\u03be\u03b5\u03c1\u03b3\u03b1\u03c3\u03af\u03b1\u03c2"],"Are you sure you want to apply the <strong>%s<\/strong> preset?":["\u0398\u03ad\u03bb\u03b5\u03c4\u03b5 \u03c3\u03af\u03b3\u03bf\u03c5\u03c1\u03b1 \u03bd\u03b1 \u03b5\u03c6\u03b1\u03c1\u03bc\u03cc\u03c3\u03b5\u03c4\u03b5 \u03c4\u03b7\u03bd \u03c0\u03c1\u03bf\u03b5\u03c0\u03b9\u03bb\u03bf\u03b3\u03ae <strong>%s<\/strong>;"],"It will override your current settings.":["\u0398\u03b1 \u03b1\u03bd\u03c4\u03b9\u03ba\u03b1\u03c4\u03b1\u03c3\u03c4\u03ae\u03c3\u03b5\u03b9 \u03c4\u03b9\u03c2 \u03c4\u03c1\u03ad\u03c7\u03bf\u03c5\u03c3\u03b5\u03c2 \u03c1\u03c5\u03b8\u03bc\u03af\u03c3\u03b5\u03b9\u03c2 \u03c3\u03b1\u03c2."],"Apply preset":["\u0395\u03c6\u03b1\u03c1\u03bc\u03bf\u03b3\u03ae \u03c0\u03c1\u03bf\u03b5\u03c0\u03b9\u03bb\u03bf\u03b3\u03ae\u03c2"],"Apply %s preset":["\u0395\u03c6\u03b1\u03c1\u03bc\u03bf\u03b3\u03ae \u03c0\u03c1\u03bf\u03c1\u03cd\u03b8\u03bc\u03b9\u03c3\u03b7\u03c2 %s"],"Save failed":["\u0397 \u03b1\u03c0\u03bf\u03b8\u03ae\u03ba\u03b5\u03c5\u03c3\u03b7 \u03b1\u03c0\u03ad\u03c4\u03c5\u03c7\u03b5"],"Apply a preset":["\u0395\u03c6\u03b1\u03c1\u03bc\u03bf\u03b3\u03ae \u03c0\u03c1\u03bf\u03c1\u03cd\u03b8\u03bc\u03b9\u03c3\u03b7\u03c2"],"Customize Design":["\u03a0\u03c1\u03bf\u03c3\u03b1\u03c1\u03bc\u03bf\u03b3\u03ae \u03c3\u03c7\u03b5\u03b4\u03af\u03b1\u03c3\u03b7\u03c2"],"Background color":["\u03a7\u03c1\u03ce\u03bc\u03b1 \u03c6\u03cc\u03bd\u03c4\u03bf\u03c5"],"Text color":["\u03a7\u03c1\u03ce\u03bc\u03b1 \u03ba\u03b5\u03b9\u03bc\u03ad\u03bd\u03bf\u03c5"],"Enable custom CSS":["\u0395\u03bd\u03b5\u03c1\u03b3\u03bf\u03c0\u03bf\u03af\u03b7\u03c3\u03b7 \u03c0\u03c1\u03bf\u03c3\u03b1\u03c1\u03bc\u03bf\u03c3\u03bc\u03ad\u03bd\u03bf\u03c5 CSS"],"Rectangle (4:3)":["\u039f\u03c1\u03b8\u03bf\u03b3\u03ce\u03bd\u03b9\u03bf (4:3)"],"Square (1:1)":["\u03a4\u03b5\u03c4\u03c1\u03ac\u03b3\u03c9\u03bd\u03bf (1:1)"],"Switcher border width":["\u03a0\u03ac\u03c7\u03bf\u03c2 \u03c0\u03b5\u03c1\u03b9\u03b3\u03c1\u03ac\u03bc\u03bc\u03b1\u03c4\u03bf\u03c2 \u03b5\u03bd\u03b1\u03bb\u03bb\u03ac\u03ba\u03c4\u03b7"],"Switcher border radius":["\u0391\u03ba\u03c4\u03af\u03bd\u03b1 \u03c0\u03b5\u03c1\u03b9\u03b3\u03c1\u03ac\u03bc\u03bc\u03b1\u03c4\u03bf\u03c2 \u03b5\u03bd\u03b1\u03bb\u03bb\u03ac\u03ba\u03c4\u03b7"],"Hover over the language switcher to see it in action!":["\u03a4\u03bf\u03c0\u03bf\u03b8\u03b5\u03c4\u03ae\u03c3\u03c4\u03b5 \u03c4\u03bf\u03bd \u03b4\u03b5\u03af\u03ba\u03c4\u03b7 \u03c0\u03ac\u03bd\u03c9 \u03b1\u03c0\u03cc \u03c4\u03bf\u03bd \u03b4\u03b9\u03b1\u03ba\u03cc\u03c0\u03c4\u03b7 \u03b3\u03bb\u03ce\u03c3\u03c3\u03b1\u03c2 \u03b3\u03b9\u03b1 \u03bd\u03b1 \u03c4\u03bf\u03bd \u03b4\u03b5\u03af\u03c4\u03b5 \u03c3\u03b5 \u03b4\u03c1\u03ac\u03c3\u03b7!"],"Switcher Preview":["\u03a0\u03c1\u03bf\u03b5\u03c0\u03b9\u03c3\u03ba\u03cc\u03c0\u03b7\u03c3\u03b7 \u03b4\u03b9\u03b1\u03ba\u03cc\u03c0\u03c4\u03b7"],"Enable Floating Switcher":["\u0395\u03bd\u03b5\u03c1\u03b3\u03bf\u03c0\u03bf\u03af\u03b7\u03c3\u03b7 \u03b1\u03b9\u03c9\u03c1\u03bf\u03cd\u03bc\u03b5\u03bd\u03bf\u03c5 \u03b4\u03b9\u03b1\u03ba\u03cc\u03c0\u03c4\u03b7"],"Switcher is enabled":["\u039f \u03b4\u03b9\u03b1\u03ba\u03cc\u03c0\u03c4\u03b7\u03c2 \u03b5\u03af\u03bd\u03b1\u03b9 \u03b5\u03bd\u03b5\u03c1\u03b3\u03bf\u03c0\u03bf\u03b9\u03b7\u03bc\u03ad\u03bd\u03bf\u03c2"],"Switcher is disabled":["\u039f \u03b4\u03b9\u03b1\u03ba\u03cc\u03c0\u03c4\u03b7\u03c2 \u03b5\u03af\u03bd\u03b1\u03b9 \u03b1\u03c0\u03b5\u03bd\u03b5\u03c1\u03b3\u03bf\u03c0\u03bf\u03b9\u03b7\u03bc\u03ad\u03bd\u03bf\u03c2"],"Switcher Type":["\u03a4\u03cd\u03c0\u03bf\u03c2 \u03b4\u03b9\u03b1\u03ba\u03cc\u03c0\u03c4\u03b7"],"Show languages as dropdown":["\u0395\u03bc\u03c6\u03ac\u03bd\u03b9\u03c3\u03b7 \u03b3\u03bb\u03c9\u03c3\u03c3\u03ce\u03bd \u03c9\u03c2 \u03b1\u03bd\u03b1\u03b4\u03c5\u03cc\u03bc\u03b5\u03bd\u03b7 \u03bb\u03af\u03c3\u03c4\u03b1"],"Show languages side by side":["\u0395\u03bc\u03c6\u03ac\u03bd\u03b9\u03c3\u03b7 \u03b3\u03bb\u03c9\u03c3\u03c3\u03ce\u03bd \u03b4\u03af\u03c0\u03bb\u03b1-\u03b4\u03af\u03c0\u03bb\u03b1"],"Background hover color":["\u03a7\u03c1\u03ce\u03bc\u03b1 \u03c6\u03cc\u03bd\u03c4\u03bf\u03c5 hover"],"Text hover color":["\u03a7\u03c1\u03ce\u03bc\u03b1 \u03ba\u03b5\u03b9\u03bc\u03ad\u03bd\u03bf\u03c5 hover"],"Switcher border color":["\u03a7\u03c1\u03ce\u03bc\u03b1 \u03c0\u03b5\u03c1\u03b9\u03b3\u03c1\u03ac\u03bc\u03bc\u03b1\u03c4\u03bf\u03c2 \u03b5\u03bd\u03b1\u03bb\u03bb\u03ac\u03ba\u03c4\u03b7"],"Flag and text size":["\u039c\u03ad\u03b3\u03b5\u03b8\u03bf\u03c2 \u03c3\u03b7\u03bc\u03b1\u03af\u03b1\u03c2 \u03ba\u03b1\u03b9 \u03ba\u03b5\u03b9\u03bc\u03ad\u03bd\u03bf\u03c5"],"Flag icons shape":["\u03a3\u03c7\u03ae\u03bc\u03b1 \u03b5\u03b9\u03ba\u03bf\u03bd\u03b9\u03b4\u03af\u03c9\u03bd \u03c3\u03b7\u03bc\u03b1\u03af\u03b1\u03c2"],"Flag icons border radius":["\u0391\u03ba\u03c4\u03af\u03bd\u03b1 \u03c0\u03b5\u03c1\u03b9\u03b3\u03c1\u03ac\u03bc\u03bc\u03b1\u03c4\u03bf\u03c2 \u03b5\u03b9\u03ba\u03bf\u03bd\u03b9\u03b4\u03af\u03c9\u03bd \u03c3\u03b7\u03bc\u03b1\u03af\u03b1\u03c2"],"Customize Layout":["\u03a0\u03c1\u03bf\u03c3\u03b1\u03c1\u03bc\u03bf\u03b3\u03ae \u03b4\u03b9\u03ac\u03c4\u03b1\u03be\u03b7\u03c2"],"Show the small Powered by TranslatePress label in the language switcher.":["\u0395\u03bc\u03c6\u03ac\u03bd\u03b9\u03c3\u03b7 \u03c4\u03b7\u03c2 \u03bc\u03b9\u03ba\u03c1\u03ae\u03c2 \u03b5\u03c4\u03b9\u03ba\u03ad\u03c4\u03b1\u03c2 Powered by TranslatePress \u03c3\u03c4\u03bf\u03bd \u03b5\u03bd\u03b1\u03bb\u03bb\u03ac\u03ba\u03c4\u03b7 \u03b3\u03bb\u03ce\u03c3\u03c3\u03b1\u03c2."],"You have unsaved changes. Leave anyway?":["\u0388\u03c7\u03b5\u03c4\u03b5 \u03bc\u03b7 \u03b1\u03c0\u03bf\u03b8\u03b7\u03ba\u03b5\u03c5\u03bc\u03ad\u03bd\u03b5\u03c2 \u03b1\u03bb\u03bb\u03b1\u03b3\u03ad\u03c2. \u039d\u03b1 \u03c6\u03cd\u03b3\u03b5\u03c4\u03b5 \u03bf\u03cd\u03c4\u03c9\u03c2 \u03ae \u03ac\u03bb\u03bb\u03c9\u03c2;"],"Switcher animations":["\u039a\u03b9\u03bd\u03ae\u03c3\u03b5\u03b9\u03c2 \u03b5\u03bd\u03b1\u03bb\u03bb\u03ac\u03ba\u03c4\u03b7"],"Transforms the language switcher into a button showing the other available language, not the current one. <br> Only works when there are exactly two languages, the default one and a translation one.":["\u039c\u03b5\u03c4\u03b1\u03c4\u03c1\u03ad\u03c0\u03b5\u03b9 \u03c4\u03bf\u03bd \u03b5\u03bd\u03b1\u03bb\u03bb\u03ac\u03ba\u03c4\u03b7 \u03b3\u03bb\u03ce\u03c3\u03c3\u03b1\u03c2 \u03c3\u03b5 \u03ba\u03bf\u03c5\u03bc\u03c0\u03af \u03c0\u03bf\u03c5 \u03b5\u03bc\u03c6\u03b1\u03bd\u03af\u03b6\u03b5\u03b9 \u03c4\u03b7\u03bd \u03ac\u03bb\u03bb\u03b7 \u03b4\u03b9\u03b1\u03b8\u03ad\u03c3\u03b9\u03bc\u03b7 \u03b3\u03bb\u03ce\u03c3\u03c3\u03b1, \u03cc\u03c7\u03b9 \u03c4\u03b7\u03bd \u03c4\u03c1\u03ad\u03c7\u03bf\u03c5\u03c3\u03b1. <br> \u039b\u03b5\u03b9\u03c4\u03bf\u03c5\u03c1\u03b3\u03b5\u03af \u03bc\u03cc\u03bd\u03bf \u03cc\u03c4\u03b1\u03bd \u03c5\u03c0\u03ac\u03c1\u03c7\u03bf\u03c5\u03bd \u03b1\u03ba\u03c1\u03b9\u03b2\u03ce\u03c2 \u03b4\u03cd\u03bf \u03b3\u03bb\u03ce\u03c3\u03c3\u03b5\u03c2, \u03b7 \u03c0\u03c1\u03bf\u03b5\u03c0\u03b9\u03bb\u03b5\u03b3\u03bc\u03ad\u03bd\u03b7 \u03ba\u03b1\u03b9 \u03bc\u03b9\u03b1 \u03b3\u03bb\u03ce\u03c3\u03c3\u03b1 \u03bc\u03b5\u03c4\u03ac\u03c6\u03c1\u03b1\u03c3\u03b7\u03c2."],"This option only works when exactly two languages are published.":["\u0391\u03c5\u03c4\u03ae \u03b7 \u03b5\u03c0\u03b9\u03bb\u03bf\u03b3\u03ae \u03bb\u03b5\u03b9\u03c4\u03bf\u03c5\u03c1\u03b3\u03b5\u03af \u03bc\u03cc\u03bd\u03bf \u03cc\u03c4\u03b1\u03bd \u03ad\u03c7\u03bf\u03c5\u03bd \u03b4\u03b7\u03bc\u03bf\u03c3\u03b9\u03b5\u03c5\u03c4\u03b5\u03af \u03b1\u03ba\u03c1\u03b9\u03b2\u03ce\u03c2 \u03b4\u03cd\u03bf \u03b3\u03bb\u03ce\u03c3\u03c3\u03b5\u03c2."],"Copied!":["\u0391\u03bd\u03c4\u03b9\u03b3\u03c1\u03ac\u03c6\u03b7\u03ba\u03b5!"],"Copy":["\u0391\u03bd\u03c4\u03b9\u03b3\u03c1\u03b1\u03c6\u03ae"],"Use shortcode on any page or widget. You can also add the Language Switcher Block in the WP Gutenberg Editor.":["\u03a7\u03c1\u03b7\u03c3\u03b9\u03bc\u03bf\u03c0\u03bf\u03b9\u03ae\u03c3\u03c4\u03b5 \u03c4\u03bf shortcode \u03c3\u03b5 \u03bf\u03c0\u03bf\u03b9\u03b1\u03b4\u03ae\u03c0\u03bf\u03c4\u03b5 \u03c3\u03b5\u03bb\u03af\u03b4\u03b1 \u03ae widget. \u039c\u03c0\u03bf\u03c1\u03b5\u03af\u03c4\u03b5 \u03b5\u03c0\u03af\u03c3\u03b7\u03c2 \u03bd\u03b1 \u03c0\u03c1\u03bf\u03c3\u03b8\u03ad\u03c3\u03b5\u03c4\u03b5 \u03c4\u03bf \u03bc\u03c0\u03bb\u03bf\u03ba \u0395\u03bd\u03b1\u03bb\u03bb\u03ac\u03ba\u03c4\u03b7 \u0393\u03bb\u03ce\u03c3\u03c3\u03b1\u03c2 \u03c3\u03c4\u03bf\u03bd \u03b5\u03c0\u03b5\u03be\u03b5\u03c1\u03b3\u03b1\u03c3\u03c4\u03ae Gutenberg \u03c4\u03bf\u03c5 WP."],"Shortcode":["Shortcode"],"Additional Settings":["\u03a0\u03c1\u03cc\u03c3\u03b8\u03b5\u03c4\u03b5\u03c2 \u03a1\u03c5\u03b8\u03bc\u03af\u03c3\u03b5\u03b9\u03c2"],"Open the language switcher shortcode by clicking on it instead of hovering. <br> Close it by clicking on it, anywhere else on the screen or by pressing the escape key. <br> This will affect only the shortcode language switcher.":["\u0391\u03bd\u03bf\u03af\u03be\u03c4\u03b5 \u03c4\u03bf\u03bd \u03b5\u03bd\u03b1\u03bb\u03bb\u03ac\u03ba\u03c4\u03b7 \u03b3\u03bb\u03ce\u03c3\u03c3\u03b1\u03c2 shortcode \u03ba\u03ac\u03bd\u03bf\u03bd\u03c4\u03b1\u03c2 \u03ba\u03bb\u03b9\u03ba \u03c3\u03b5 \u03b1\u03c5\u03c4\u03cc\u03bd \u03b1\u03bd\u03c4\u03af \u03bd\u03b1 \u03c4\u03bf\u03c0\u03bf\u03b8\u03b5\u03c4\u03b5\u03af\u03c4\u03b5 \u03c4\u03bf\u03bd \u03b4\u03b5\u03af\u03ba\u03c4\u03b7 \u03c0\u03ac\u03bd\u03c9 \u03c4\u03bf\u03c5. <br> \u039a\u03bb\u03b5\u03af\u03c3\u03c4\u03b5 \u03c4\u03bf\u03bd \u03ba\u03ac\u03bd\u03bf\u03bd\u03c4\u03b1\u03c2 \u03ba\u03bb\u03b9\u03ba \u03c3\u03b5 \u03b1\u03c5\u03c4\u03cc\u03bd, \u03bf\u03c0\u03bf\u03c5\u03b4\u03ae\u03c0\u03bf\u03c4\u03b5 \u03b1\u03bb\u03bb\u03bf\u03cd \u03c3\u03c4\u03b7\u03bd \u03bf\u03b8\u03cc\u03bd\u03b7 \u03ae \u03c0\u03b1\u03c4\u03ce\u03bd\u03c4\u03b1\u03c2 \u03c4\u03bf \u03c0\u03bb\u03ae\u03ba\u03c4\u03c1\u03bf escape. <br> \u0391\u03c5\u03c4\u03cc \u03b8\u03b1 \u03b5\u03c0\u03b7\u03c1\u03b5\u03ac\u03c3\u03b5\u03b9 \u03bc\u03cc\u03bd\u03bf \u03c4\u03bf\u03bd \u03b5\u03bd\u03b1\u03bb\u03bb\u03ac\u03ba\u03c4\u03b7 \u03b3\u03bb\u03ce\u03c3\u03c3\u03b1\u03c2 shortcode."],"Menu Switcher Layout":["\u0394\u03b9\u03ac\u03c4\u03b1\u03be\u03b7 \u0395\u03bd\u03b1\u03bb\u03bb\u03ac\u03ba\u03c4\u03b7 \u039c\u03b5\u03bd\u03bf\u03cd"],"Go to <a href=\"\/wp-admin\/nav-menus.php\">Appearance \u2192 Menus<\/a> to add languages to the Language Switcher in any menu.<br> <a href=\"https:\/\/translatepress.com\/docs\/settings\/language-switcher\/?utm_source=tp-language-switcher&utm_medium=client-site&utm_campaign=ls-menu-item#menu-switcher\" target=\"_blank\">Learn more in our documentation.<\/a>":["\u039c\u03b5\u03c4\u03b1\u03b2\u03b5\u03af\u03c4\u03b5 \u03c3\u03c4\u03b9\u03c2 <a href=\"\/wp-admin\/nav-menus.php\">\u0395\u03bc\u03c6\u03ac\u03bd\u03b9\u03c3\u03b7 \u2192 \u039c\u03b5\u03bd\u03bf\u03cd<\/a> \u03b3\u03b9\u03b1 \u03bd\u03b1 \u03c0\u03c1\u03bf\u03c3\u03b8\u03ad\u03c3\u03b5\u03c4\u03b5 \u03b3\u03bb\u03ce\u03c3\u03c3\u03b5\u03c2 \u03c3\u03c4\u03bf\u03bd \u0395\u03bd\u03b1\u03bb\u03bb\u03ac\u03ba\u03c4\u03b7 \u0393\u03bb\u03ce\u03c3\u03c3\u03b1\u03c2 \u03c3\u03b5 \u03bf\u03c0\u03bf\u03b9\u03bf\u03b4\u03ae\u03c0\u03bf\u03c4\u03b5 \u03bc\u03b5\u03bd\u03bf\u03cd.<br> <a href=\"https:\/\/translatepress.com\/docs\/settings\/language-switcher\/?utm_source=tp-language-switcher&utm_medium=client-site&utm_campaign=ls-menu-item#menu-switcher\" target=\"_blank\">\u039c\u03ac\u03b8\u03b5\u03c4\u03b5 \u03c0\u03b5\u03c1\u03b9\u03c3\u03c3\u03cc\u03c4\u03b5\u03c1\u03b1 \u03c3\u03c4\u03b7\u03bd \u03c4\u03b5\u03ba\u03bc\u03b7\u03c1\u03af\u03c9\u03c3\u03ae \u03bc\u03b1\u03c2.<\/a>"]}}}