msgstr ""
"Vaikekeeleks tõstetava keele lokaadi kood. Peab olema juba seadistatud "
"tõlkekeel."

#, tp-ai, tp-glo-ee8b4f9f
msgid "You do not have permission to manage TranslatePress settings."
msgstr "Teil puudub õigus hallata TranslatePressi seadistusi."

#, tp-ai
msgid ""
"Invalid language code. Allowed characters: A-Z, a-z, 0-9, hyphen, "
"underscore."
msgstr "Vigane keelekood. Lubatud märgid: A-Z, a-z, 0-9, sidekriips, alakriips."

#, tp-ai, tp-glo-ee8b4f9f
msgid "Language code \"%s\" is not recognized by TranslatePress."
msgstr "TranslatePress ei tunne keelekoodi \"%s\" ära."

#, tp-ai
msgid "Language \"%s\" is already configured."
msgstr "Keel \"%s\" on juba seadistatud."

#, tp-ai
msgid ""
"Your current license allows up to %d additional language(s). Upgrade or "
"activate a Pro license to add more."
msgstr ""
"Teie praegune litsents võimaldab kuni %d täiendavat keelt. Täiendage või "
"aktiveerige Pro-litsents, et lisada rohkem."

#, tp-ai, tp-glo-ee8b4f9f
msgid "TranslatePress rejected the new language during settings sanitization."
msgstr "TranslatePress lükkas uue keele seadistuste puhastamise käigus tagasi."

#, tp-ai, tp-glo-c6709f3f, tp-glo-ee8b4f9f, tp-glo-f7c8926f
msgid ""
"Enabling Automatic Translation with the TranslatePress AI engine requires "
"an active TranslatePress license. Activate a license first with "
"translatepress/set-license-key, or pass a different engine (e.g. "
"\"google_translate_v2\", \"deepl\")."
msgstr ""
"Automaatse tõlke lubamine mootoriga TranslatePress AI nõuab aktiivset "
"TranslatePress litsentsi. Aktiveeri kõigepealt litsents käsuga "
"translatepress/set-license-key või edasta teine mootor (nt "
"\"google_translate_v2\", \"deepl\")."

msgid "Your license key expired on %s."
msgstr "Sinu litsentsivõti aegus %s."

#, tp-ai
msgid "Your license key has expired."
msgstr "Teie litsentsivõti on aegunud."

msgid "Your license key has been disabled."
msgstr "Sinu litsentsivõti on keelatud."

#, tp-glo-ee8b4f9f
msgid "Your TranslatePress license key is invalid or missing."
msgstr "Sinu TranslatePress litsentsivõti on kehtetu või puudub."

#, tp-ai, tp-glo-666af81f, tp-glo-9fa92a70, tp-glo-ee8b4f9f
