msgstr ""
"Keel \"%s\" pole hetkel seadistatud. Lisage see kõigepealt käsuga "
"translatepress/add-language."

#, tp-ai
msgid "The default language is always published and cannot be unpublished."
msgstr "Vaikimisi keel on alati avaldatud ja seda ei saa avaldamata muuta."

#, tp-ai, tp-ctx-07893e52, tp-glo-67834fcb
msgid "Slug \"%1$s\" is already in use by language \"%2$s\"."
msgstr "Slug \"%1$s\" on juba kasutusel keele \"%2$s\" jaoks."

