3bb\u03b5"],"Bordered":["\u039c\u03b5 \u03c0\u03b5\u03c1\u03af\u03b3\u03c1\u03b1\u03bc\u03bc\u03b1"],"Popup Preview":["\u03a0\u03c1\u03bf\u03b5\u03c0\u03b9\u03c3\u03ba\u03cc\u03c0\u03b7\u03c3\u03b7 \u03b1\u03bd\u03b1\u03b4\u03c5\u03cc\u03bc\u03b5\u03bd\u03bf\u03c5 \u03c0\u03b1\u03c1\u03b1\u03b8\u03cd\u03c1\u03bf\u03c5"],"User Language Detection Method":["\u039c\u03ad\u03b8\u03bf\u03b4\u03bf\u03c2 \u03b5\u03bd\u03c4\u03bf\u03c0\u03b9\u03c3\u03bc\u03bf\u03cd \u03b3\u03bb\u03ce\u03c3\u03c3\u03b1\u03c2 \u03c7\u03c1\u03ae\u03c3\u03c4\u03b7"],"Notification Behavior":["\u03a3\u03c5\u03bc\u03c0\u03b5\u03c1\u03b9\u03c6\u03bf\u03c1\u03ac \u03b5\u03b9\u03b4\u03bf\u03c0\u03bf\u03b9\u03ae\u03c3\u03b5\u03c9\u03bd"],"Popup Content":["\u03a0\u03b5\u03c1\u03b9\u03b5\u03c7\u03cc\u03bc\u03b5\u03bd\u03bf \u03b1\u03bd\u03b1\u03b4\u03c5\u03cc\u03bc\u03b5\u03bd\u03bf\u03c5 \u03c0\u03b1\u03c1\u03b1\u03b8\u03cd\u03c1\u03bf\u03c5"],"Apply a preset":["\u0395\u03c6\u03b1\u03c1\u03bc\u03bf\u03b3\u03ae \u03c0\u03c1\u03bf\u03c1\u03cd\u03b8\u03bc\u03b9\u03c3\u03b7\u03c2"],"Customize Design":["\u03a0\u03c1\u03bf\u03c3\u03b1\u03c1\u03bc\u03bf\u03b3\u03ae \u03c3\u03c7\u03b5\u03b4\u03af\u03b1\u03c3\u03b7\u03c2"],"Language detection":["\u0391\u03bd\u03af\u03c7\u03bd\u03b5\u03c5\u03c3\u03b7 \u03b3\u03bb\u03ce\u03c3\u03c3\u03b1\u03c2"],"Select how the language should be detected for first time visitors.<br>The visitor's last displayed language will be remembered through cookies.":["\u0395\u03c0\u03b9\u03bb\u03ad\u03be\u03c4\u03b5 \u03c0\u03ce\u03c2 \u03b8\u03b1 \u03b3\u03af\u03bd\u03b5\u03c4\u03b1\u03b9 \u03bf \u03b5\u03bd\u03c4\u03bf\u03c0\u03b9\u03c3\u03bc\u03cc\u03c2 \u03c4\u03b7\u03c2 \u03b3\u03bb\u03ce\u03c3\u03c3\u03b1\u03c2 \u03b3\u03b9\u03b1 \u03b5\u03c0\u03b9\u03c3\u03ba\u03ad\u03c0\u03c4\u03b5\u03c2 \u03c0\u03bf\u03c5 \u03b5\u03c0\u03b9\u03c3\u03ba\u03ad\u03c0\u03c4\u03bf\u03bd\u03c4\u03b1\u03b9 \u03b3\u03b9\u03b1 \u03c0\u03c1\u03ce\u03c4\u03b7 \u03c6\u03bf\u03c1\u03ac.<br>\u0397 \u03c4\u03b5\u03bb\u03b5\u03c5\u03c4\u03b1\u03af\u03b1 \u03b3\u03bb\u03ce\u03c3\u03c3\u03b1 \u03c0\u03bf\u03c5 \u03b5\u03bc\u03c6\u03b1\u03bd\u03af\u03c3\u03c4\u03b7\u03ba\u03b5 \u03c3\u03c4\u03bf\u03bd \u03b5\u03c0\u03b9\u03c3\u03ba\u03ad\u03c0\u03c4\u03b7 \u03b8\u03b1 \u03b1\u03c0\u03bf\u03b8\u03b7\u03ba\u03b5\u03cd\u03b5\u03c4\u03b1\u03b9 \u03bc\u03ad\u03c3\u03c9 cookies."],"Popup display":["\u0395\u03bc\u03c6\u03ac\u03bd\u03b9\u03c3\u03b7 \u03b1\u03bd\u03b1\u03b4\u03c5\u03cc\u03bc\u03b5\u03bd\u03bf\u03c5 \u03c0\u03b1\u03c1\u03b1\u03b8\u03cd\u03c1\u03bf\u03c5"],"Conditionally display popup based on language":["\u03a5\u03c0\u03cc \u03cc\u03c1\u03bf\u03c5\u03c2 \u03b5\u03bc\u03c6\u03ac\u03bd\u03b9\u03c3\u03b7 \u03b1\u03bd\u03b1\u03b4\u03c5\u03cc\u03bc\u03b5\u03bd\u03bf\u03c5 \u03c0\u03b1\u03c1\u03b1\u03b8\u03cd\u03c1\u03bf\u03c5 \u03bc\u03b5 \u03b2\u03ac\u03c3\u03b7 \u03c4\u03b7 \u03b3\u03bb\u03ce\u03c3\u03c3\u03b1"],"Popup Type":["\u03a4\u03cd\u03c0\u03bf\u03c2 \u03b1\u03bd\u03b1\u03b4\u03c5\u03cc\u03bc\u03b5\u03bd\u03bf\u03c5 \u03c0\u03b1\u03c1\u03b1\u03b8\u03cd\u03c1\u03bf\u03c5"],"Visitors will be redirected directly when a different preferred language is detected.":["\u039f\u03b9 \u03b5\u03c0\u03b9\u03c3\u03ba\u03ad\u03c0\u03c4\u03b5\u03c2 \u03b8\u03b1 \u03b1\u03bd\u03b1\u03ba\u03b1\u03c4\u03b5\u03c5\u03b8\u03cd\u03bd\u03bf\u03bd\u03c4\u03b1\u03b9 \u03b1\u03c0\u03b5\u03c5\u03b8\u03b5\u03af\u03b1\u03c2 \u03cc\u03c4\u03b1\u03bd \u03b1\u03bd\u03b9\u03c7\u03bd\u03b5\u03c5\u03c4\u03b5\u03af \u03b4\u03b9\u03b1\u03c6\u03bf\u03c1\u03b5\u03c4\u03b9\u03ba\u03ae \u03c0\u03c1\u03bf\u03c4\u03b9\u03bc\u03ce\u03bc\u03b5\u03bd\u03b7 \u03b3\u03bb\u03ce\u03c3\u03c3\u03b1."],"Popup Text":["\u039a\u03b5\u03af\u03bc\u03b5\u03bd\u03bf \u03b1\u03bd\u03b1\u03b4\u03c5\u03cc\u03bc\u03b5\u03bd\u03bf\u03c5 \u03c0\u03b1\u03c1\u03b1\u03b8\u03cd\u03c1\u03bf\u03c5"],"Button Text":["\u039a\u03b5\u03af\u03bc\u03b5\u03bd\u03bf \u03ba\u03bf\u03c5\u03bc\u03c0\u03b9\u03bf\u03cd"],"Close Button Text":["\u039a\u03b5\u03af\u03bc\u03b5\u03bd\u03bf \u03ba\u03bf\u03c5\u03bc\u03c0\u03b9\u03bf\u03cd \u03ba\u03bb\u03b5\u03b9\u03c3\u03af\u03bc\u03b1\u03c4\u03bf\u03c2"],"Background color":["\u03a7\u03c1\u03ce\u03bc\u03b1 \u03c6\u03cc\u03bd\u03c4\u03bf\u03c5"],"Text color":["\u03a7\u03c1\u03ce\u03bc\u03b1 \u03ba\u03b5\u03b9\u03bc\u03ad\u03bd\u03bf\u03c5"],"Button background color":["\u03a7\u03c1\u03ce\u03bc\u03b1 \u03c6\u03cc\u03bd\u03c4\u03bf\u03c5 \u03ba\u03bf\u03c5\u03bc\u03c0\u03b9\u03bf\u03cd"],"Button hover color":["\u03a7\u03c1\u03ce\u03bc\u03b1 hover \u03ba\u03bf\u03c5\u03bc\u03c0\u03b9\u03bf\u03cd"],"Button text color":["\u03a7\u03c1\u03ce\u03bc\u03b1 \u03ba\u03b5\u03b9\u03bc\u03ad\u03bd\u03bf\u03c5 \u03ba\u03bf\u03c5\u03bc\u03c0\u03b9\u03bf\u03cd"],"Button border radius":["\u0391\u03ba\u03c4\u03af\u03bd\u03b1 \u03b3\u03c9\u03bd\u03af\u03b1\u03c2 \u03ba\u03bf\u03c5\u03bc\u03c0\u03b9\u03bf\u03cd"],"Close icon color":["\u03a7\u03c1\u03ce\u03bc\u03b1 \u03b5\u03b9\u03ba\u03bf\u03bd\u03b9\u03b4\u03af\u03bf\u03c5 \u03ba\u03bb\u03b5\u03b9\u03c3\u03af\u03bc\u03b1\u03c4\u03bf\u03c2"],"Overlay color":["\u03a7\u03c1\u03ce\u03bc\u03b1 \u03b5\u03c0\u03b9\u03ba\u03ac\u03bb\u03c5\u03c8\u03b7\u03c2"],"Entrance animation":["\u039a\u03af\u03bd\u03b7\u03c3\u03b7 \u03b5\u03b9\u03c3\u03cc\u03b4\u03bf\u03c5"],"Animation":["\u039a\u03af\u03bd\u03b7\u03c3\u03b7"],"Fade":["\u0395\u03be\u03b1\u03c3\u03b8\u03ad\u03bd\u03b9\u03c3\u03b7"],"Slide from top":["\u039f\u03bb\u03af\u03c3\u03b8\u03b7\u03c3\u03b7 \u03b1\u03c0\u03cc \u03c0\u03ac\u03bd\u03c9"],"Slide from right":["\u039f\u03bb\u03af\u03c3\u03b8\u03b7\u03c3\u03b7 \u03b1\u03c0\u03cc \u03c4\u03b1 \u03b4\u03b5\u03be\u03b9\u03ac"],"Slide from bottom":["\u039f\u03bb\u03af\u03c3\u03b8\u03b7\u03c3\u03b7 \u03b1\u03c0\u03cc \u03ba\u03ac\u03c4\u03c9"],"Slide from left":["\u039f\u03bb\u03af\u03c3\u03b8\u03b7\u03c3\u03b7 \u03b1\u03c0\u03cc \u03c4\u03b1 \u03b1\u03c1\u03b9\u03c3\u03c4\u03b5\u03c1\u03ac"],"Enable custom CSS":["\u0395\u03bd\u03b5\u03c1\u03b3\u03bf\u03c0\u03bf\u03af\u03b7\u03c3\u03b7 \u03c0\u03c1\u03bf\u03c3\u03b1\u03c1\u03bc\u03bf\u03c3\u03bc\u03ad\u03bd\u03bf\u03c5 CSS"],"No names":["\u03a7\u03c9\u03c1\u03af\u03c2 \u03bf\u03bd\u03cc\u03bc\u03b1\u03c4\u03b1"],"Show flags":["\u0395\u03bc\u03c6\u03ac\u03bd\u03b9\u03c3\u03b7 \u03c3\u03b7\u03bc\u03b1\u03b9\u03ce\u03bd"],"Rectangle (4:3)":["\u039f\u03c1\u03b8\u03bf\u03b3\u03ce\u03bd\u03b9\u03bf (4:3)"],"Square (1:1)":["\u03a4\u03b5\u03c4\u03c1\u03ac\u03b3\u03c9\u03bd\u03bf (1:1)"],"Flag border radius":["\u0391\u03ba\u03c4\u03af\u03bd\u03b1 \u03c0\u03b5\u03c1\u03b9\u03b3\u03c1\u03ac\u03bc\u03bc\u03b1\u03c4\u03bf\u03c2 \u03c3\u03b7\u03bc\u03b1\u03af\u03b1\u03c2"],"Switcher background":["\u03a6\u03cc\u03bd\u03c4\u03bf \u03b5\u03bd\u03b1\u03bb\u03bb\u03ac\u03ba\u03c4\u03b7"],"Switcher hover background":["\u03a6\u03cc\u03bd\u03c4\u03bf \u03b5\u03bd\u03b1\u03bb\u03bb\u03ac\u03ba\u03c4\u03b7 \u03ba\u03b1\u03c4\u03ac \u03c4\u03b7\u03bd \u03b1\u03b9\u03ce\u03c1\u03b7\u03c3\u03b7"],"Switcher text":["\u039a\u03b5\u03af\u03bc\u03b5\u03bd\u03bf \u03b5\u03bd\u03b1\u03bb\u03bb\u03ac\u03ba\u03c4\u03b7"],"Switcher hover text":["\u039a\u03b5\u03af\u03bc\u03b5\u03bd\u03bf \u03b5\u03bd\u03b1\u03bb\u03bb\u03ac\u03ba\u03c4\u03b7 \u03ba\u03b1\u03c4\u03ac \u03c4\u03b7\u03bd \u03b1\u03b9\u03ce\u03c1\u03b7\u03c3\u03b7"],"Switcher border":["\u03a0\u03b5\u03c1\u03af\u03b3\u03c1\u03b1\u03bc\u03bc\u03b1 \u03b5\u03bd\u03b1\u03bb\u03bb\u03ac\u03ba\u03c4\u03b7"],"Switcher border width":["\u03a0\u03ac\u03c7\u03bf\u03c2 \u03c0\u03b5\u03c1\u03b9\u03b3\u03c1\u03ac\u03bc\u03bc\u03b1\u03c4\u03bf\u03c2 \u03b5\u03bd\u03b1\u03bb\u03bb\u03ac\u03ba\u03c4\u03b7"],"Switcher border radius":["\u0391\u03ba\u03c4\u03af\u03bd\u03b1 \u03c0\u03b5\u03c1\u03b9\u03b3\u03c1\u03ac\u03bc\u03bc\u03b1\u03c4\u03bf\u03c2 \u03b5\u03bd\u03b1\u03bb\u03bb\u03ac\u03ba\u03c4\u03b7"]}}}