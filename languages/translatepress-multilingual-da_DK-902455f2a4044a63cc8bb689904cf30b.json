{"translation-revision-date":"2026-10-13T10:48:03+03:00","generator":"WP-CLI\/2.12.0","source":"assets\/js\/trp-lang-switcher-configurator.js","domain":"messages","locale_data":{"messages":{"":{"domain":"messages","lang":"da_DK","plural-forms":"nplurals=2; plural=(n != 1);"},"Open language switcher only on click":["\u00c5bn sprogv\u00e6lgeren kun ved klik"],"Add":["Tilf\u00f8j"],"Select language":["V\u00e6lg et sprog"],"Bottom Right":["Nederst til h\u00f8jre"],"Bottom Left":["Nederst til venstre"],"Top Right":["\u00d8verst til h\u00f8jre"],"Top Left":["\u00d8verst til venstre"],"Dark":["M\u00f8rk"],"Custom":["Brugerdefineret"],"Show opposite language":["Vis det modsatte sprog"],"Normal":["Normal"],"Large":["Stor"],"Cancel":["Annuller"],"Default":["Standard"],"Border":["Kant"],"Transparent":["Gennemsigtig"],"Show \"Powered by TranslatePress\"":["Vis \"Powered by TranslatePress\""],"Open colour picker":["\u00c5bn farvev\u00e6lger"],"Enabled":["Aktiveret"],"Disabled":["Deaktiveret"],"Write custom CSS here...":["Skriv tilpasset CSS her..."],"Include":["Inkluder"],"Exclude":["Ekskluder"],"Content Restriction Mode":["Indholdsbegr\u00e6nsningstilstand"],"No languages selected":["Ingen sprog valgt"],"Saving...":["Gemmer..."],"Saved!":["Gemt!"],"Save changes":["Gem \u00e6ndringer"],"Revert to last saved values":["Gendan til senest gemte v\u00e6rdier"],"Revert changes":["Gendan \u00e6ndringer"],"Restoring will revert to the last saved version and discard your current edits.":["Gendannelse vil tilbagef\u00f8re til den senest gemte version og kassere dine nuv\u00e6rende \u00e6ndringer."],"Revert":["Gendan"],"Keep editing":["Forts\u00e6t redigering"],"Are you sure you want to apply the <strong>%s<\/strong> preset?":["Er du sikker p\u00e5, at du vil anvende forudindstillingen <strong>%s<\/strong>?"],"It will override your current settings.":["Det vil overskrive dine nuv\u00e6rende indstillinger."],"Apply preset":["Anvend forudindstilling"],"Apply %s preset":["Anvend %s-forudindstilling"],"Save failed":["Kunne ikke gemme"],"Apply a preset":["Anvend en forudindstilling"],"Customize Design":["Tilpas design"],"Background color":["Baggrundsfarve"],"Text color":["Tekstfarve"],"Enable custom CSS":["Aktiv\u00e9r tilpasset CSS"],"Rectangle (4:3)":["Rektangel (4:3)"],"Square (1:1)":["Kvadrat (1:1)"],"Switcher border width":["Switchers kantbredde"],"Switcher border radius":["Switchers kantradius"],"Hover over the language switcher to see it in action!":["Hold musen over sprogv\u00e6lgeren for at se den i aktion!"],"Switcher Preview":["Forh\u00e5ndsvisning af v\u00e6lger"],"Enable Floating Switcher":["Aktiv\u00e9r flydende v\u00e6lger"],"Switcher is enabled":["V\u00e6lgeren er aktiveret"],"Switcher is disabled":["V\u00e6lgeren er deaktiveret"],"Switcher Type":["V\u00e6lgertype"],"Show languages as dropdown":["Vis sprog som rullemenu"],"Show languages side by side":["Vis sprog side om side"],"Background hover color":["Baggrundsfarve ved hover"],"Text hover color":["Tekstfarve ved hover"],"Switcher border color":["Switchers kantfarve"],"Flag and text size":["Flag- og tekstst\u00f8rrelse"],"Flag icons shape":["Flagikonernes form"],"Flag icons border radius":["Flagikonernes kantradius"],"Customize Layout":["Tilpas layout"],"Show the small Powered by TranslatePress label in the language switcher.":["Vis den lille etiket med Powered by TranslatePress i sprogswitchen."],"You have unsaved changes. Leave anyway?":["Du har ugemte \u00e6ndringer. Vil du forlade alligevel?"],"Switcher animations":["Switcher-animationer"],"Transforms the language switcher into a button showing the other available language, not the current one. <br> Only works when there are exactly two languages, the default one and a translation one.":["Transformerer sprogskifteren til en knap, der viser det andet tilg\u00e6ngelige sprog, ikke det aktuelle. <br> Virker kun, n\u00e5r der er pr\u00e6cis to sprog, standardsproget og et overs\u00e6ttelsessprog."],"This option only works when exactly two languages are published.":["Denne indstilling virker kun, n\u00e5r pr\u00e6cis to sprog er publiceret."],"Copied!":["Kopieret!"],"Copy":["Kopier"],"Use shortcode on any page or widget. You can also add the Language Switcher Block in the WP Gutenberg Editor.":["Brug shortcode p\u00e5 enhver side eller widget. Du kan ogs\u00e5 tilf\u00f8je sprogskifterblokken i WP Gutenberg-editoren."],"Shortcode":["Shortcode"],"Additional Settings":["Yderligere indstillinger"],"Open the language switcher shortcode by clicking on it instead of hovering. <br> Close it by clicking on it, anywhere else on the screen or by pressing the escape key. <br> This will affect only the shortcode language switcher.":["\u00c5bn sprogskifter-shortcoden ved at klikke p\u00e5 den i stedet for at holde mark\u00f8ren over den. <br> Luk den ved at klikke p\u00e5 den, hvor som helst andet p\u00e5 sk\u00e6rmen eller ved at trykke p\u00e5 escape-tasten. <br> Dette p\u00e5virker kun shortcode-sprogskifteren."],"Menu Switcher Layout":["Menuskifter-layout"],"Go to <a href=\"\/wp-admin\/nav-menus.php\">Appearance \u2192 Menus<\/a> to add languages to the Language Switcher in any menu.<br> <a href=\"https:\/\/translatepress.com\/docs\/settings\/language-switcher\/?utm_source=tp-language-switcher&utm_medium=client-site&utm_campaign=ls-menu-item#menu-switcher\" target=\"_blank\">Learn more in our documentation.<\/a>":["G\u00e5 til <a href=\"\/wp-admin\/nav-menus.php\">Udseende \u2192 Menuer<\/a> for at tilf\u00f8je sprog til sprogskifteren i enhver menu.<br> <a href=\"https:\/\/translatepress.com\/docs\/settings\/language-switcher\/?utm_source=tp-language-switcher&utm_medium=client-site&utm_campaign=ls-menu-item#menu-switcher\" target=\"_blank\">L\u00e6s mere i vores dokumentation.<\/a>"]}}}