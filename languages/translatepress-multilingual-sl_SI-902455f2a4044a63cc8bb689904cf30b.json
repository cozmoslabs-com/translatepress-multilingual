{"translation-revision-date":"2026-10-13T10:48:03+03:00","generator":"WP-CLI\/2.12.0","source":"assets\/js\/trp-lang-switcher-configurator.js","domain":"messages","locale_data":{"messages":{"":{"domain":"messages","lang":"sl_SI","plural-forms":"nplurals=4; plural=(n%100==1 ? 0 : n%100==2 ? 1 : n%100==3 || n%100==4 ? 2 : 3);"},"Open language switcher only on click":["Odpiraj izbirnik jezika le ob kliku"],"Add":["Dodaj"],"Select language":["Izberite jezik"],"Bottom Right":["Spodaj desno"],"Bottom Left":["Spodaj levo"],"Top Right":["Zgoraj desno"],"Top Left":["Zgoraj levo"],"Dark":["Temno"],"Custom":["Po meri"],"Show opposite language":["Prika\u017ei drugi jezik"],"Normal":["Normalno"],"Large":["Veliko"],"Cancel":["Prekli\u010di"],"Default":["Privzeto"],"Border":["Obroba"],"Transparent":["Prosojna"],"Show \"Powered by TranslatePress\"":["Prika\u017ei \"Powered by TranslatePress\""],"Open colour picker":["Odpri izbirnik barv"],"Enabled":["Omogo\u010deno"],"Disabled":["Onemogo\u010deno"],"Write custom CSS here...":["Tukaj napi\u0161ite CSS po meri..."],"Include":["Vklju\u010di"],"Exclude":["Izklju\u010di"],"Content Restriction Mode":["Na\u010din omejevanja vsebine"],"No languages selected":["Ni izbranih jezikov"],"Saving...":["Shranjevanje..."],"Saved!":["Shranjeno!"],"Save changes":["Shrani spremembe"],"Revert to last saved values":["Povrni na zadnje shranjene vrednosti"],"Revert changes":["Povrni spremembe"],"Restoring will revert to the last saved version and discard your current edits.":["S povrnitvijo se bo stanje vrnilo na zadnjo shranjeno razli\u010dico in zavrglo trenutne spremembe."],"Revert":["Povrni"],"Keep editing":["Nadaljuj z urejanjem"],"Are you sure you want to apply the <strong>%s<\/strong> preset?":["Ali ste prepri\u010dani, da \u017eelite uporabiti prednastavitev <strong>%s<\/strong>?"],"It will override your current settings.":["Prepisala bo va\u0161e trenutne nastavitve."],"Apply preset":["Uporabi prednastavitev"],"Apply %s preset":["Uporabi %s prednastavitev"],"Save failed":["Shranjevanje ni uspelo"],"Apply a preset":["Uporabi prednastavitev"],"Customize Design":["Prilagodi oblikovanje"],"Background color":["Barva ozadja"],"Text color":["Barva besedila"],"Enable custom CSS":["Omogo\u010di CSS po meri"],"Rectangle (4:3)":["Pravokotnik (4:3)"],"Square (1:1)":["Kvadrat (1:1)"],"Switcher border width":["Debelina obrobe stikala"],"Switcher border radius":["Zaobljenost obrobe stikala"],"Hover over the language switcher to see it in action!":["Premaknite kazalec \u010dez preklopnik jezikov, da ga vidite v delovanju!"],"Switcher Preview":["Predogled preklopnika"],"Enable Floating Switcher":["Omogo\u010di plavajo\u010di preklopnik"],"Switcher is enabled":["Preklopnik je omogo\u010den"],"Switcher is disabled":["Preklopnik je onemogo\u010den"],"Switcher Type":["Vrsta preklopnika"],"Show languages as dropdown":["Prika\u017ei jezike kot spustni seznam"],"Show languages side by side":["Prika\u017ei jezike drug ob drugem"],"Background hover color":["Barva ozadja ob premiku mi\u0161ke"],"Text hover color":["Barva besedila ob premiku mi\u0161ke"],"Switcher border color":["Barva obrobe stikala"],"Flag and text size":["Velikost zastav in besedila"],"Flag icons shape":["Oblika ikon zastav"],"Flag icons border radius":["Zaobljenost obrobe ikon zastav"],"Customize Layout":["Prilagodi postavitev"],"Show the small Powered by TranslatePress label in the language switcher.":["Prika\u017ei majhno oznako Powered by TranslatePress v jezikovnem stikalu."],"You have unsaved changes. Leave anyway?":["Imate neshranjene spremembe. Vseeno zapustite?"],"Switcher animations":["Animacije stikala"],"Transforms the language switcher into a button showing the other available language, not the current one. <br> Only works when there are exactly two languages, the default one and a translation one.":["Preoblikuje izbirnik jezika v gumb, ki prikazuje drugi razpolo\u017eljivi jezik, ne trenutnega. <br> Deluje samo, ko sta natan\u010dno dva jezika: privzeti in prevodni."],"This option only works when exactly two languages are published.":["Ta mo\u017enost deluje samo, ko sta objavljena natan\u010dno dva jezika."],"Copied!":["Kopirano!"],"Copy":["Kopiraj"],"Use shortcode on any page or widget. You can also add the Language Switcher Block in the WP Gutenberg Editor.":["Uporabite shortcode na kateri koli strani ali pripomo\u010dku. Lahko tudi dodate blok izbirnika jezika v urejevalnik WP Gutenberg."],"Shortcode":["Shortcode"],"Additional Settings":["Dodatne nastavitve"],"Open the language switcher shortcode by clicking on it instead of hovering. <br> Close it by clicking on it, anywhere else on the screen or by pressing the escape key. <br> This will affect only the shortcode language switcher.":["Odprite izbirnik jezika shortcode s klikom nanj namesto lebdenja. <br> Zaprite ga s klikom nanj, s klikom kamor koli drugje na zaslonu ali s pritiskom na tipko Escape. <br> To bo vplivalo samo na izbirnik jezika shortcode."],"Menu Switcher Layout":["Postavitev izbirnika v meniju"],"Go to <a href=\"\/wp-admin\/nav-menus.php\">Appearance \u2192 Menus<\/a> to add languages to the Language Switcher in any menu.<br> <a href=\"https:\/\/translatepress.com\/docs\/settings\/language-switcher\/?utm_source=tp-language-switcher&utm_medium=client-site&utm_campaign=ls-menu-item#menu-switcher\" target=\"_blank\">Learn more in our documentation.<\/a>":["Pojdite na <a href=\"\/wp-admin\/nav-menus.php\">Videz \u2192 Meniji<\/a>, da dodate jezike v izbirnik jezika v kateri koli meni.<br> <a href=\"https:\/\/translatepress.com\/docs\/settings\/language-switcher\/?utm_source=tp-language-switcher&utm_medium=client-site&utm_campaign=ls-menu-item#menu-switcher\" target=\"_blank\">Ve\u010d informacij najdete v na\u0161i dokumentaciji.<\/a>"]}}}