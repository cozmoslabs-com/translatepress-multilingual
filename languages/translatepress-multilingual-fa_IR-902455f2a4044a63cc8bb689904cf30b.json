{"translation-revision-date":"2026-09-17 10:04:08+0000","generator":"WP-CLI\/2.12.0","source":"assets\/js\/trp-lang-switcher-configurator.js","domain":"messages","locale_data":{"messages":{"":{"domain":"messages","lang":"fa_IR","plural-forms":"nplurals=2; plural=(n > 1);"},"Open language switcher only on click":["\u062a\u063a\u06cc\u06cc\u0631 \u0632\u0628\u0627\u0646 \u0631\u0627 \u0641\u0642\u0637 \u0628\u0627 \u06a9\u0644\u06cc\u06a9 \u0628\u0627\u0632 \u06a9\u0646\u06cc\u062f"],"Add":["\u0627\u0641\u0632\u0648\u062f\u0646"],"Select language":["\u0627\u0646\u062a\u062e\u0627\u0628 \u0632\u0628\u0627\u0646"],"Bottom Right":["\u067e\u0627\u06cc\u06cc\u0646 \u0631\u0627\u0633\u062a"],"Bottom Left":["\u067e\u0627\u06cc\u06cc\u0646 \u0686\u067e"],"Top Right":["\u0628\u0627\u0644\u0627 \u0631\u0627\u0633\u062a"],"Top Left":["\u0628\u0627\u0644\u0627 \u0686\u067e"],"Dark":["\u062a\u06cc\u0631\u0647"],"Custom":["\u0633\u0641\u0627\u0631\u0634\u06cc"],"Show opposite language":["\u0646\u0645\u0627\u06cc\u0634 \u0632\u0628\u0627\u0646 \u0645\u0642\u0627\u0628\u0644"],"Normal":["\u0645\u0639\u0645\u0648\u0644\u06cc"],"Large":["\u0628\u0632\u0631\u06af"],"Cancel":["\u0644\u063a\u0648"],"Default":["\u067e\u06cc\u0634\u200c\u0641\u0631\u0636"],"Border":["\u0645\u0631\u0632"],"Transparent":["\u0634\u0641\u0627\u0641"],"Show \"Powered by TranslatePress\"":["\u0646\u0645\u0627\u06cc\u0634 \u00ab\u0642\u062f\u0631\u062a\u200c\u06af\u0631\u0641\u062a\u0647 \u0627\u0632 TranslatePress\u00bb"],"Open colour picker":["\u0628\u0627\u0632 \u06a9\u0631\u062f\u0646 \u0627\u0646\u062a\u062e\u0627\u0628\u200c\u06af\u0631 \u0631\u0646\u06af"],"Enabled":["\u0641\u0639\u0627\u0644"],"Disabled":["\u063a\u06cc\u0631\u0641\u0639\u0627\u0644"],"Write custom CSS here...":["CSS \u0633\u0641\u0627\u0631\u0634\u06cc \u0631\u0627 \u0627\u06cc\u0646\u062c\u0627 \u0628\u0646\u0648\u06cc\u0633\u06cc\u062f..."],"Include":["\u0634\u0627\u0645\u0644"],"Exclude":["\u0645\u0633\u062a\u062b\u0646\u06cc \u06a9\u0631\u062f\u0646"],"Content Restriction Mode":["\u062d\u0627\u0644\u062a \u0645\u062d\u062f\u0648\u062f\u06cc\u062a \u0645\u062d\u062a\u0648\u0627"],"No languages selected":["\u0632\u0628\u0627\u0646\u06cc \u0627\u0646\u062a\u062e\u0627\u0628 \u0646\u0634\u062f\u0647 \u0627\u0633\u062a"],"Saving...":["\u062f\u0631 \u062d\u0627\u0644 \u0630\u062e\u06cc\u0631\u0647..."],"Saved!":["\u0630\u062e\u06cc\u0631\u0647 \u0634\u062f!"],"Save changes":["\u0630\u062e\u06cc\u0631\u0647 \u062a\u063a\u06cc\u06cc\u0631\u0627\u062a"],"Revert to last saved values":["\u0628\u0627\u0632\u06af\u0634\u062a \u0628\u0647 \u0622\u062e\u0631\u06cc\u0646 \u0645\u0642\u0627\u062f\u06cc\u0631 \u0630\u062e\u06cc\u0631\u0647\u200c\u0634\u062f\u0647"],"Revert changes":["\u0628\u0627\u0632\u06af\u0631\u062f\u0627\u0646\u062f\u0646 \u062a\u063a\u06cc\u06cc\u0631\u0627\u062a"],"Restoring will revert to the last saved version and discard your current edits.":["\u0628\u0627\u0632\u06af\u0631\u062f\u0627\u0646\u062f\u0646\u060c \u0628\u0647 \u0622\u062e\u0631\u06cc\u0646 \u0646\u0633\u062e\u0647 \u0630\u062e\u06cc\u0631\u0647\u200c\u0634\u062f\u0647 \u0628\u0627\u0632\u0645\u06cc\u200c\u06af\u0631\u062f\u062f \u0648 \u0648\u06cc\u0631\u0627\u06cc\u0634\u200c\u0647\u0627\u06cc \u0641\u0639\u0644\u06cc \u0634\u0645\u0627 \u0631\u0627 \u0644\u063a\u0648 \u0645\u06cc\u200c\u06a9\u0646\u062f."],"Revert":["\u0628\u0627\u0632\u06af\u0631\u062f\u0627\u0646\u062f\u0646"],"Keep editing":["\u0627\u062f\u0627\u0645\u0647 \u0648\u06cc\u0631\u0627\u06cc\u0634"],"Are you sure you want to apply the <strong>%s<\/strong> preset?":["\u0622\u06cc\u0627 \u0645\u0637\u0645\u0626\u0646 \u0647\u0633\u062a\u06cc\u062f \u06a9\u0647 \u0645\u06cc\u200c\u062e\u0648\u0627\u0647\u06cc\u062f \u067e\u06cc\u0634\u200c\u062a\u0646\u0638\u06cc\u0645 <strong>%s<\/strong> \u0631\u0627 \u0627\u0639\u0645\u0627\u0644 \u06a9\u0646\u06cc\u062f\u061f"],"It will override your current settings.":["\u0627\u06cc\u0646 \u06a9\u0627\u0631 \u062a\u0646\u0638\u06cc\u0645\u0627\u062a \u0641\u0639\u0644\u06cc \u0634\u0645\u0627 \u0631\u0627 \u0628\u0627\u0632\u0646\u0648\u06cc\u0633\u06cc \u0645\u06cc\u200c\u06a9\u0646\u062f."],"Apply preset":["\u0627\u0639\u0645\u0627\u0644 \u067e\u06cc\u0634\u200c\u062a\u0646\u0638\u06cc\u0645"],"Apply %s preset":["\u0627\u0639\u0645\u0627\u0644 \u067e\u06cc\u0634\u200c\u062a\u0646\u0638\u06cc\u0645 %s"],"Save failed":["\u0630\u062e\u06cc\u0631\u0647 \u0646\u0627\u0645\u0648\u0641\u0642 \u0628\u0648\u062f"],"Apply a preset":["\u0627\u0639\u0645\u0627\u0644 \u06cc\u06a9 \u067e\u06cc\u0634\u200c\u062a\u0646\u0638\u06cc\u0645"],"Customize Design":["\u0633\u0641\u0627\u0631\u0634\u06cc\u200c\u0633\u0627\u0632\u06cc \u0637\u0631\u0627\u062d\u06cc"],"Background color":["\u0631\u0646\u06af \u067e\u0633\u200c\u0632\u0645\u06cc\u0646\u0647"],"Text color":["\u0631\u0646\u06af \u0645\u062a\u0646"],"Enable custom CSS":["\u0641\u0639\u0627\u0644\u200c\u0633\u0627\u0632\u06cc CSS \u0633\u0641\u0627\u0631\u0634\u06cc"],"Rectangle (4:3)":["\u0645\u0633\u062a\u0637\u06cc\u0644 (\u06f4:\u06f3)"],"Square (1:1)":["\u0645\u0631\u0628\u0639 (\u06f1:\u06f1)"],"Switcher border width":["\u0639\u0631\u0636 \u062d\u0627\u0634\u06cc\u0647 \u062c\u0627\u0628\u062c\u0627\u06a9\u0646\u0646\u062f\u0647"],"Switcher border radius":["\u0634\u0639\u0627\u0639 \u062d\u0627\u0634\u06cc\u0647 \u062c\u0627\u0628\u062c\u0627\u06a9\u0646\u0646\u062f\u0647"],"Hover over the language switcher to see it in action!":["\u0628\u0631\u0627\u06cc \u062f\u06cc\u062f\u0646 \u0639\u0645\u0644\u06a9\u0631\u062f \u0622\u0646\u060c \u0646\u0634\u0627\u0646\u06af\u0631 \u0631\u0627 \u0631\u0648\u06cc \u062c\u0627\u0628\u062c\u0627\u0632 \u0632\u0628\u0627\u0646 \u0646\u06af\u0647 \u062f\u0627\u0631\u06cc\u062f!"],"Switcher Preview":["\u067e\u06cc\u0634\u200c\u0646\u0645\u0627\u06cc\u0634 \u062c\u0627\u0628\u062c\u0627\u0632"],"Enable Floating Switcher":["\u0641\u0639\u0627\u0644\u200c\u0633\u0627\u0632\u06cc \u062c\u0627\u0628\u062c\u0627\u0632 \u0634\u0646\u0627\u0648\u0631"],"Switcher is enabled":["\u062c\u0627\u0628\u062c\u0627\u0632 \u0641\u0639\u0627\u0644 \u0627\u0633\u062a"],"Switcher is disabled":["\u062c\u0627\u0628\u062c\u0627\u0632 \u063a\u06cc\u0631\u0641\u0639\u0627\u0644 \u0627\u0633\u062a"],"Switcher Type":["\u0646\u0648\u0639 \u062c\u0627\u0628\u062c\u0627\u0632"],"Show languages as dropdown":["\u0646\u0645\u0627\u06cc\u0634 \u0632\u0628\u0627\u0646\u200c\u0647\u0627 \u0628\u0647 \u0635\u0648\u0631\u062a \u06a9\u0634\u0648\u06cc\u06cc"],"Show languages side by side":["\u0646\u0645\u0627\u06cc\u0634 \u0632\u0628\u0627\u0646\u200c\u0647\u0627 \u06a9\u0646\u0627\u0631 \u0647\u0645"],"Background hover color":["\u0631\u0646\u06af \u067e\u0633\u200c\u0632\u0645\u06cc\u0646\u0647 \u062f\u0631 \u062d\u0627\u0644\u062a \u0634\u0646\u0627\u0648\u0631"],"Text hover color":["\u0631\u0646\u06af \u0645\u062a\u0646 \u062f\u0631 \u062d\u0627\u0644\u062a \u0634\u0646\u0627\u0648\u0631"],"Switcher border color":["\u0631\u0646\u06af \u062d\u0627\u0634\u06cc\u0647 \u062c\u0627\u0628\u062c\u0627\u06a9\u0646\u0646\u062f\u0647"],"Flag and text size":["\u0627\u0646\u062f\u0627\u0632\u0647 \u067e\u0631\u0686\u0645 \u0648 \u0645\u062a\u0646"],"Flag icons shape":["\u0634\u06a9\u0644 \u0622\u06cc\u06a9\u0648\u0646\u200c\u0647\u0627\u06cc \u067e\u0631\u0686\u0645"],"Flag icons border radius":["\u0634\u0639\u0627\u0639 \u062d\u0627\u0634\u06cc\u0647 \u0622\u06cc\u06a9\u0648\u0646\u200c\u0647\u0627\u06cc \u067e\u0631\u0686\u0645"],"Customize Layout":["\u0633\u0641\u0627\u0631\u0634\u06cc\u200c\u0633\u0627\u0632\u06cc \u0686\u06cc\u062f\u0645\u0627\u0646"],"Show the small Powered by TranslatePress label in the language switcher.":["\u0646\u0645\u0627\u06cc\u0634 \u0628\u0631\u0686\u0633\u0628 \u06a9\u0648\u0686\u06a9 Powered by TranslatePress \u062f\u0631 \u062c\u0627\u0628\u062c\u0627\u06a9\u0646\u0646\u062f\u0647 \u0632\u0628\u0627\u0646"],"You have unsaved changes. Leave anyway?":["\u062a\u063a\u06cc\u06cc\u0631\u0627\u062a \u0630\u062e\u06cc\u0631\u0647\u200c\u0646\u0634\u062f\u0647 \u062f\u0627\u0631\u06cc\u062f. \u0628\u0627\u0632 \u0647\u0645 \u062e\u0627\u0631\u062c \u0645\u06cc\u200c\u0634\u0648\u06cc\u062f\u061f"],"Switcher animations":["\u0627\u0646\u06cc\u0645\u06cc\u0634\u0646\u200c\u0647\u0627\u06cc \u062c\u0627\u0628\u062c\u0627\u06a9\u0646\u0646\u062f\u0647"],"Transforms the language switcher into a button showing the other available language, not the current one. <br> Only works when there are exactly two languages, the default one and a translation one.":["\u062a\u0628\u062f\u06cc\u0644\u200c\u06a9\u0646\u0646\u062f\u0647\u0654 \u0632\u0628\u0627\u0646 \u0631\u0627 \u0628\u0647 \u062f\u06a9\u0645\u0647\u200c\u0627\u06cc \u062a\u0628\u062f\u06cc\u0644 \u0645\u06cc\u200c\u06a9\u0646\u062f \u06a9\u0647 \u0632\u0628\u0627\u0646 \u062f\u06cc\u06af\u0631 \u0645\u0648\u062c\u0648\u062f \u0631\u0627 \u0646\u0634\u0627\u0646 \u0645\u06cc\u200c\u062f\u0647\u062f\u060c \u0646\u0647 \u0632\u0628\u0627\u0646 \u0641\u0639\u0644\u06cc \u0631\u0627. <br> \u062a\u0646\u0647\u0627 \u0632\u0645\u0627\u0646\u06cc \u06a9\u0627\u0631 \u0645\u06cc\u200c\u06a9\u0646\u062f \u06a9\u0647 \u062f\u0642\u06cc\u0642\u0627\u064b \u062f\u0648 \u0632\u0628\u0627\u0646 \u0648\u062c\u0648\u062f \u062f\u0627\u0634\u062a\u0647 \u0628\u0627\u0634\u062f\u060c \u0632\u0628\u0627\u0646 \u067e\u06cc\u0634\u200c\u0641\u0631\u0636 \u0648 \u0632\u0628\u0627\u0646 \u062a\u0631\u062c\u0645\u0647."],"This option only works when exactly two languages are published.":["\u0627\u06cc\u0646 \u06af\u0632\u06cc\u0646\u0647 \u062a\u0646\u0647\u0627 \u0632\u0645\u0627\u0646\u06cc \u06a9\u0627\u0631 \u0645\u06cc\u200c\u06a9\u0646\u062f \u06a9\u0647 \u062f\u0642\u06cc\u0642\u0627\u064b \u062f\u0648 \u0632\u0628\u0627\u0646 \u0645\u0646\u062a\u0634\u0631 \u0634\u062f\u0647 \u0628\u0627\u0634\u062f."],"Copied!":["\u0631\u0648\u0646\u0648\u0634\u062a \u0634\u062f!"],"Copy":["\u0631\u0648\u0646\u0648\u0634\u062a"],"Use shortcode on any page or widget. You can also add the Language Switcher Block in the WP Gutenberg Editor.":["\u0627\u0632 shortcode \u062f\u0631 \u0647\u0631 \u0628\u0631\u06af\u0647 \u06cc\u0627 \u0627\u0628\u0632\u0627\u0631\u06a9 \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u06a9\u0646\u06cc\u062f. \u0647\u0645\u0686\u0646\u06cc\u0646 \u0645\u06cc\u200c\u062a\u0648\u0627\u0646\u06cc\u062f \u0628\u0644\u0648\u06a9 \u062a\u0628\u062f\u06cc\u0644\u200c\u06a9\u0646\u0646\u062f\u0647\u0654 \u0632\u0628\u0627\u0646 \u0631\u0627 \u062f\u0631 \u0648\u06cc\u0631\u0627\u06cc\u0634\u06af\u0631 Gutenberg \u0648\u0631\u062f\u067e\u0631\u0633 \u0627\u0636\u0627\u0641\u0647 \u06a9\u0646\u06cc\u062f."],"Shortcode":["Shortcode"],"Additional Settings":["\u062a\u0646\u0638\u06cc\u0645\u0627\u062a \u062a\u06a9\u0645\u06cc\u0644\u06cc"],"Open the language switcher shortcode by clicking on it instead of hovering. <br> Close it by clicking on it, anywhere else on the screen or by pressing the escape key. <br> This will affect only the shortcode language switcher.":["\u062a\u0628\u062f\u06cc\u0644\u200c\u06a9\u0646\u0646\u062f\u0647\u0654 \u0632\u0628\u0627\u0646 shortcode \u0631\u0627 \u0628\u0627 \u06a9\u0644\u06cc\u06a9 \u0628\u0647 \u062c\u0627\u06cc \u0642\u0631\u0627\u0631 \u062f\u0627\u062f\u0646 \u0646\u0634\u0627\u0646\u06af\u0631 \u0628\u0627\u0632 \u06a9\u0646\u06cc\u062f. <br> \u0622\u0646 \u0631\u0627 \u0628\u0627 \u06a9\u0644\u06cc\u06a9 \u0631\u0648\u06cc \u0622\u0646\u060c \u062f\u0631 \u0647\u0631 \u062c\u0627\u06cc \u062f\u06cc\u06af\u0631 \u0635\u0641\u062d\u0647 \u06cc\u0627 \u0628\u0627 \u0641\u0634\u0631\u062f\u0646 \u06a9\u0644\u06cc\u062f escape \u0628\u0628\u0646\u062f\u06cc\u062f. <br> \u0627\u06cc\u0646 \u062a\u0646\u0647\u0627 \u0628\u0631 \u062a\u0628\u062f\u06cc\u0644\u200c\u06a9\u0646\u0646\u062f\u0647\u0654 \u0632\u0628\u0627\u0646 shortcode \u062a\u0623\u062b\u06cc\u0631 \u0645\u06cc\u200c\u06af\u0630\u0627\u0631\u062f."],"Menu Switcher Layout":["\u0686\u06cc\u062f\u0645\u0627\u0646 \u062a\u0628\u062f\u06cc\u0644\u200c\u06a9\u0646\u0646\u062f\u0647\u0654 \u0645\u0646\u0648"],"Go to <a href=\"\/wp-admin\/nav-menus.php\">Appearance \u2192 Menus<\/a> to add languages to the Language Switcher in any menu.<br> <a href=\"https:\/\/translatepress.com\/docs\/settings\/language-switcher\/?utm_source=tp-language-switcher&utm_medium=client-site&utm_campaign=ls-menu-item#menu-switcher\" target=\"_blank\">Learn more in our documentation.<\/a>":["\u0628\u0647 <a href=\"\/wp-admin\/nav-menus.php\">\u0646\u0645\u0627\u06cc\u0634 \u2192 \u0641\u0647\u0631\u0633\u062a\u200c\u0647\u0627<\/a> \u0628\u0631\u0648\u06cc\u062f \u062a\u0627 \u0632\u0628\u0627\u0646\u200c\u0647\u0627 \u0631\u0627 \u0628\u0647 \u062a\u0628\u062f\u06cc\u0644\u200c\u06a9\u0646\u0646\u062f\u0647\u0654 \u0632\u0628\u0627\u0646 \u062f\u0631 \u0647\u0631 \u0641\u0647\u0631\u0633\u062a\u06cc \u0627\u0636\u0627\u0641\u0647 \u06a9\u0646\u06cc\u062f.<br> <a href=\"https:\/\/translatepress.com\/docs\/settings\/language-switcher\/?utm_source=tp-language-switcher&utm_medium=client-site&utm_campaign=ls-menu-item#menu-switcher\" target=\"_blank\">\u062f\u0631 \u0645\u0633\u062a\u0646\u062f\u0627\u062a \u0645\u0627 \u0628\u06cc\u0634\u062a\u0631 \u0628\u06cc\u0627\u0645\u0648\u0632\u06cc\u062f.<\/a>"]}}}