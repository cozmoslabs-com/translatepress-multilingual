440\u0435\u043c\u0438\u043a\u0430\u0447\u0430"],"Hover over the language switcher to see it in action!":["\u041d\u0430\u0432\u0435\u0434\u0456\u0442\u044c \u043a\u0443\u0440\u0441\u043e\u0440 \u043d\u0430 \u043f\u0435\u0440\u0435\u043c\u0438\u043a\u0430\u0447 \u043c\u043e\u0432, \u0449\u043e\u0431 \u043f\u043e\u0431\u0430\u0447\u0438\u0442\u0438 \u0439\u043e\u0433\u043e \u0432 \u0434\u0456\u0457!"],"Switcher Preview":["\u041f\u043e\u043f\u0435\u0440\u0435\u0434\u043d\u0456\u0439 \u043f\u0435\u0440\u0435\u0433\u043b\u044f\u0434 \u043f\u0435\u0440\u0435\u043c\u0438\u043a\u0430\u0447\u0430"],"Enable Floating Switcher":["\u0423\u0432\u0456\u043c\u043a\u043d\u0443\u0442\u0438 \u043f\u043b\u0430\u0432\u0430\u044e\u0447\u0438\u0439 \u043f\u0435\u0440\u0435\u043c\u0438\u043a\u0430\u0447"],"Switcher is enabled":["\u041f\u0435\u0440\u0435\u043c\u0438\u043a\u0430\u0447 \u0443\u0432\u0456\u043c\u043a\u043d\u0435\u043d\u043e"],"Switcher is disabled":["\u041f\u0435\u0440\u0435\u043c\u0438\u043a\u0430\u0447 \u0432\u0438\u043c\u043a\u043d\u0435\u043d\u043e"],"Switcher Type":["\u0422\u0438\u043f \u043f\u0435\u0440\u0435\u043c\u0438\u043a\u0430\u0447\u0430"],"Show languages as dropdown":["\u041f\u043e\u043a\u0430\u0437\u0443\u0432\u0430\u0442\u0438 \u043c\u043e\u0432\u0438 \u044f\u043a \u0432\u0438\u043f\u0430\u0434\u043d\u0438\u0439 \u0441\u043f\u0438\u0441\u043e\u043a"],"Show languages side by side":["\u041f\u043e\u043a\u0430\u0437\u0443\u0432\u0430\u0442\u0438 \u043c\u043e\u0432\u0438 \u043f\u043e\u0440\u0443\u0447"],"Background hover color":["\u041a\u043e\u043b\u0456\u0440 \u0442\u043b\u0430 \u043f\u0440\u0438 \u043d\u0430\u0432\u0435\u0434\u0435\u043d\u043d\u0456"],"Text hover color":["\u041a\u043e\u043b\u0456\u0440 \u0442\u0435\u043a\u0441\u0442\u0443 \u043f\u0440\u0438 \u043d\u0430\u0432\u0435\u0434\u0435\u043d\u043d\u0456"],"Switcher border color":["\u041a\u043e\u043b\u0456\u0440 \u0440\u0430\u043c\u043a\u0438 \u043f\u0435\u0440\u0435\u043c\u0438\u043a\u0430\u0447\u0430"],"Flag and text size":["\u0420\u043e\u0437\u043c\u0456\u0440 \u043f\u0440\u0430\u043f\u043e\u0440\u0446\u044f \u0442\u0430 \u0442\u0435\u043a\u0441\u0442\u0443"],"Flag icons shape":["\u0424\u043e\u0440\u043c\u0430 \u043f\u0456\u043a\u0442\u043e\u0433\u0440\u0430\u043c \u043f\u0440\u0430\u043f\u043e\u0440\u0446\u0456\u0432"],"Flag icons border radius":["\u0420\u0430\u0434\u0456\u0443\u0441 \u0437\u0430\u043e\u043a\u0440\u0443\u0433\u043b\u0435\u043d\u043d\u044f \u043f\u0456\u043a\u0442\u043e\u0433\u0440\u0430\u043c \u043f\u0440\u0430\u043f\u043e\u0440\u0446\u0456\u0432"],"Customize Layout":["\u041d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u0442\u0438 \u043c\u0430\u043a\u0435\u0442"],"Show the small Powered by TranslatePress label in the language switcher.":["\u041f\u043e\u043a\u0430\u0437\u0443\u0432\u0430\u0442\u0438 \u043c\u0430\u043b\u0435\u043d\u044c\u043a\u0438\u0439 \u043d\u0430\u043f\u0438\u0441 \u00abPowered by TranslatePress\u00bb \u0443 \u043f\u0435\u0440\u0435\u043c\u0438\u043a\u0430\u0447\u0456 \u043c\u043e\u0432."],"You have unsaved changes. Leave anyway?":["\u0423 \u0432\u0430\u0441 \u0454 \u043d\u0435\u0437\u0431\u0435\u0440\u0435\u0436\u0435\u043d\u0456 \u0437\u043c\u0456\u043d\u0438. \u0412\u0438\u0439\u0442\u0438 \u0432\u0441\u0435 \u043e\u0434\u043d\u043e?"],"Switcher animations":["\u0410\u043d\u0456\u043c\u0430\u0446\u0456\u0457 \u043f\u0435\u0440\u0435\u043c\u0438\u043a\u0430\u0447\u0430"],"Transforms the language switcher into a button showing the other available language, not the current one. <br> Only works when there are exactly two languages, the default one and a translation one.":["\u041f\u0435\u0440\u0435\u0442\u0432\u043e\u0440\u044e\u0454 \u043f\u0435\u0440\u0435\u043c\u0438\u043a\u0430\u0447 \u043c\u043e\u0432\u0438 \u043d\u0430 \u043a\u043d\u043e\u043f\u043a\u0443, \u044f\u043a\u0430 \u043f\u043e\u043a\u0430\u0437\u0443\u0454 \u0456\u043d\u0448\u0443 \u0434\u043e\u0441\u0442\u0443\u043f\u043d\u0443 \u043c\u043e\u0432\u0443, \u0430 \u043d\u0435 \u043f\u043e\u0442\u043e\u0447\u043d\u0443. <br> \u041f\u0440\u0430\u0446\u044e\u0454 \u043b\u0438\u0448\u0435 \u0442\u043e\u0434\u0456, \u043a\u043e\u043b\u0438 \u0454 \u0440\u0456\u0432\u043d\u043e \u0434\u0432\u0456 \u043c\u043e\u0432\u0438: \u0442\u0438\u043f\u043e\u0432\u0430 \u0442\u0430 \u043f\u0435\u0440\u0435\u043a\u043b\u0430\u0434\u0435\u043d\u0430."],"This option only works when exactly two languages are published.":["\u0426\u044f \u043e\u043f\u0446\u0456\u044f \u043f\u0440\u0430\u0446\u044e\u0454 \u043b\u0438\u0448\u0435 \u0442\u043e\u0434\u0456, \u043a\u043e\u043b\u0438 \u043e\u043f\u0443\u0431\u043b\u0456\u043a\u043e\u0432\u0430\u043d\u043e \u0440\u0456\u0432\u043d\u043e \u0434\u0432\u0456 \u043c\u043e\u0432\u0438."],"Copied!":["\u0421\u043a\u043e\u043f\u0456\u0439\u043e\u0432\u0430\u043d\u043e!"],"Copy":["\u041a\u043e\u043f\u0456\u044e\u0432\u0430\u0442\u0438"],"Use shortcode on any page or widget. You can also add the Language Switcher Block in the WP Gutenberg Editor.":["\u0412\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u0439\u0442\u0435 shortcode \u043d\u0430 \u0431\u0443\u0434\u044c-\u044f\u043a\u0456\u0439 \u0441\u0442\u043e\u0440\u0456\u043d\u0446\u0456 \u0430\u0431\u043e \u0443 \u0432\u0456\u0434\u0436\u0435\u0442\u0456. \u0412\u0438 \u0442\u0430\u043a\u043e\u0436 \u043c\u043e\u0436\u0435\u0442\u0435 \u0434\u043e\u0434\u0430\u0442\u0438 \u0431\u043b\u043e\u043a \u043f\u0435\u0440\u0435\u043c\u0438\u043a\u0430\u0447\u0430 \u043c\u043e\u0432\u0438 \u0443 \u0440\u0435\u0434\u0430\u043a\u0442\u043e\u0440\u0456 WP Gutenberg."],"Shortcode":["shortcode"],"Additional Settings":["\u0414\u043e\u0434\u0430\u0442\u043a\u043e\u0432\u0456 \u043d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u043d\u044f"],"Open the language switcher shortcode by clicking on it instead of hovering. <br> Close it by clicking on it, anywhere else on the screen or by pressing the escape key. <br> This will affect only the shortcode language switcher.":["\u0412\u0456\u0434\u043a\u0440\u0438\u0432\u0430\u0439\u0442\u0435 shortcode \u043f\u0435\u0440\u0435\u043c\u0438\u043a\u0430\u0447\u0430 \u043c\u043e\u0432\u0438 \u043a\u043b\u0430\u0446\u0430\u043d\u043d\u044f\u043c \u043d\u0430 \u043d\u044c\u043e\u043c\u0443 \u0437\u0430\u043c\u0456\u0441\u0442\u044c \u043d\u0430\u0432\u0435\u0434\u0435\u043d\u043d\u044f. <br> \u0417\u0430\u043a\u0440\u0438\u0432\u0430\u0439\u0442\u0435 \u0439\u043e\u0433\u043e \u043a\u043b\u0430\u0446\u0430\u043d\u043d\u044f\u043c \u043d\u0430 \u043d\u044c\u043e\u043c\u0443, \u043a\u043b\u0430\u0446\u0430\u043d\u043d\u044f\u043c \u0431\u0443\u0434\u044c-\u0434\u0435 \u0449\u0435 \u043d\u0430 \u0435\u043a\u0440\u0430\u043d\u0456 \u0430\u0431\u043e \u043d\u0430\u0442\u0438\u0441\u043a\u0430\u043d\u043d\u044f\u043c \u043a\u043b\u0430\u0432\u0456\u0448\u0456 Escape. <br> \u0426\u0435 \u0432\u043f\u043b\u0438\u043d\u0435 \u043b\u0438\u0448\u0435 \u043d\u0430 shortcode \u043f\u0435\u0440\u0435\u043c\u0438\u043a\u0430\u0447\u0430 \u043c\u043e\u0432\u0438."],"Menu Switcher Layout":["\u041c\u0430\u043a\u0435\u0442 \u043f\u0435\u0440\u0435\u043c\u0438\u043a\u0430\u0447\u0430 \u0432 \u043c\u0435\u043d\u044e"],"Go to <a href=\"\/wp-admin\/nav-menus.php\">Appearance \u2192 Menus<\/a> to add languages to the Language Switcher in any menu.<br> <a href=\"https:\/\/translatepress.com\/docs\/settings\/language-switcher\/?utm_source=tp-language-switcher&utm_medium=client-site&utm_campaign=ls-menu-item#menu-switcher\" target=\"_blank\">Learn more in our documentation.<\/a>":["\u041f\u0435\u0440\u0435\u0439\u0434\u0456\u0442\u044c \u0443 \u0440\u043e\u0437\u0434\u0456\u043b <a href=\"\/wp-admin\/nav-menus.php\">\u0417\u043e\u0432\u043d\u0456\u0448\u043d\u0456\u0439 \u0432\u0438\u0433\u043b\u044f\u0434 \u2192 \u041c\u0435\u043d\u044e<\/a>, \u0449\u043e\u0431 \u0434\u043e\u0434\u0430\u0442\u0438 \u043c\u043e\u0432\u0438 \u0434\u043e \u043f\u0435\u0440\u0435\u043c\u0438\u043a\u0430\u0447\u0430 \u043c\u043e\u0432\u0438 \u0432 \u0431\u0443\u0434\u044c-\u044f\u043a\u043e\u043c\u0443 \u043c\u0435\u043d\u044e.<br> <a href=\"https:\/\/translatepress.com\/docs\/settings\/language-switcher\/?utm_source=tp-language-switcher&utm_medium=client-site&utm_campaign=ls-menu-item#menu-switcher\" target=\"_blank\">\u0414\u043e\u043a\u043b\u0430\u0434\u043d\u0456\u0448\u0435 \u0432 \u043d\u0430\u0448\u0456\u0439 \u0434\u043e\u043a\u0443\u043c\u0435\u043d\u0442\u0430\u0446\u0456\u0457.<\/a>"]}}}